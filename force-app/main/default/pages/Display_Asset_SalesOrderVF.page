<apex:page StandardController="Asset" extensions="Display_Asset_SalesOrders" lightningStylesheets="true">

  <apex:pageMessages ></apex:pageMessages>
  <apex:form > 
          
          <apex:outputPanel rendered="{!ShowSalesOrders}">
       
              <apex:pageblock >
                  <apex:pageBlockSection columns="1">  
              
                         <apex:pageBlockTable value="{!listOfcntWrapper}" var="cnt"> 
                                
                               <apex:column headerValue=" SONumber "> 
                               
                   <apex:outputlink value="#" onclick="window.open('/{!cnt.so.id}','_blank');">{!cnt.so.SO_Number__c}</apex:outputlink>
                   
                      </apex:column> 
                                                         
                                 <apex:column value="{!cnt.so.name}"/>
                                                    
                                                    <apex:column value="{!cnt.ast.Asset_Type__c}"/>
                                                    
                                                    <apex:column value="{!cnt.ast.Order_Type__c}"/>
                            
                         </apex:pageBlockTable>              
                     
                  </apex:pageBlockSection>
                 
              </apex:pageblock>
              
      </apex:outputPanel>
    </apex:form>
</apex:page>