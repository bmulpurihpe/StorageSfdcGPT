    function timezoneCalculationCompleted(rawOffset,dstOffset,timeZoneName,Latitude,Longitude){        
        if (dstOffset != null && rawOffset != null && dstOffset != "" && rawOffset != "" ) {                                        
            var currentDate = new Date();
            var assetUTCDate = new Date(Date.UTC(currentDate.getUTCFullYear(), currentDate.getUTCMonth(), currentDate.getUTCDate(),
                                                 currentDate.getUTCHours(), currentDate.getUTCMinutes(), currentDate.getUTCSeconds(), currentDate.getUTCMilliseconds()));
            
            assetUTCDate = assetUTCDate.addSeconds((parseInt(rawOffset) + parseInt(dstOffset)));
            
            actualUTCDateWithoutNearestHalfTime = assetUTCDate;
            actualdatestring =  actualUTCDateWithoutNearestHalfTime.toGMTString();
            actualdatestring = convertGMTStringToReadableFormat(actualdatestring);
            
            assetUTCDate = correctDateToNearestHalfHour(assetUTCDate);
            assetdateString = assetUTCDate.toGMTString();
            assetdateString = convertGMTStringToReadableFormat(assetdateString);
            
            /*alert(assetdateString);
                        
                        var time = assetdateString.substr(assetdateString.indexOf(' ')+1);
                        var hour = time.substr(0,time.indexOf(':'));
                        var inteHour = parseInt(hour);
                        var fourHouradd = inteHour+4;
                         
                        var select = document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:SLAUpliftSectionItemId:deliveryTimeSelectList');
                        
                        for (var i =fourHouradd ; i<=24; i++){
                            var opt = document.createElement('option');
                            opt.value = i+':00';
                            opt.innerHTML = i+':00';
                            select.appendChild(opt);
                        }
                        */
            var dateArr = assetdateString.split(":");
            assetdateString = dateArr[0].replace("00","12")+":"+dateArr[1];
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetDateTimeId').value = assetdateString;
            
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetActualDateTimeId').value = actualdatestring;
            
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetLatitudeId').value = Latitude;
            
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetLongitudeId').value = Longitude;
            
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetActualOffsetId').value = parseInt(rawOffset) + ' (' + parseInt(rawOffset) / 3600 + ' hours)';
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetDstOffsetId').value = parseInt(dstOffset) + ' (' + parseInt(dstOffset) / 3600 + ' hours)';
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:AssetTimeZoneNameId').value = timeZoneName;                                
        }
        else {
            resetAssetTimeZoneFields();
            
        }
    }
    
