    function showPopup(event) {
        var optionValue = document.getElementById('Page:myForm:pageBlockID:ComponentReloadId:reasonSection:reasonValue').options;
        var mapValues = {!stringReasonWithToolTipMap};
        var popupString='<table><tr><td><b>Reason</b></td><td><b>Description</b></td></tr>';
        
        for(i=0;i<optionValue.length;i++){
            var value = mapValues[optionValue[i].text];
            if(value!= undefined){
                //                popupString = popupString + '<em>' + optionValue[i].text + '</em>&nbsp;&nbsp;-&nbsp;&nbsp;' + value + '<br/>';
                popupString = popupString + '<tr><td>' + optionValue[i].text + '</td><td>' + value + '</td></tr>';                
            }
            else if(optionValue[i].text != '--None--'){
                popupString = popupString + '<tr><td>' + optionValue[i].text + '</td><td>' + '-' + '</td></tr>';
            }
        }
        popupString+='</table>';
        var inputField = event.target;
        var popup = document.createElement('div');
        popup.className = 'popup';
        popup.innerHTML = popupString;
        //        popup.innerHTML = '<em>Reason</em>  -  Description<br/><b>----------------------------</b><br/>'+popupString;
        inputField.parentNode.appendChild(popup);
        var inputWidth = document.getElementById('Page:myForm:pageBlockID:ComponentReloadId:reasonSection:reasonValue').offsetWidth;
        // console.log(inputWidth+10)
        popup.style.left = inputWidth+10+'px';
        popup.style.top ='35px';
        
        popup.style.position ='absolute';
        popup.style.display = 'block';
    }
    
    function hidePopup() {
        var popup = document.getElementsByClassName('popup')[0];
        popup.parentNode.removeChild(popup);
    }
