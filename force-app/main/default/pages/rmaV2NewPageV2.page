    function SLAOnChange(){
        var sla = document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:rmaUpliftId').value;
        var serviceCodeElement  = document.getElementById('Page:myForm:pageBlockID:OnsiteServiceCodeSectionId:OverrideOnsiteSchedulingCodeId');
        var serviceCode = serviceCodeElement ? serviceCodeElement.value : '';
        
        if(sla != 'Scheduled' && sla != 'Pickup Order' && !serviceCode.includes('SCHEDULED-10')){
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:SLAUpliftSectionItemId:SLADeliveryDateId').disabled = true;
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:SLAUpliftSectionItemId:SLADeliveryTimeId').disabled = true;
        }
        else if(sla == 'Scheduled' || sla == 'Pickup Order' || serviceCode.includes('SCHEDULED-10')){
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:SLAUpliftSectionItemId:SLADeliveryDateId').disabled = false;
            document.getElementById('Page:myForm:pageBlockID:SLAUpliftSectionId:SLAUpliftSectionItemId:SLADeliveryTimeId').disabled = false;
        }
    }
    
