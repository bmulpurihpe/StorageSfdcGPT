    // Added by Exafort for SFDC-2058
    function fixDoubleQuotes() {
        var errorElements = document.getElementsByClassName("errorMsg");
        for (var i = 0; i < errorElements.length; i++) {
            // Decode HTML entities using a textarea
            var txt = document.createElement("textarea");
            txt.innerHTML = errorElements[i].innerHTML;
            var decoded = txt.value;
            // Replace smart quotes “ and ” with normal "
            decoded = decoded.replace(/[“”]/g, '"');
            // Update the error message
            errorElements[i].innerHTML = decoded;
        }
    }
