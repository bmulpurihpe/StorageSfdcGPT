    function getTimeStamp(time) {
        return Math.round(time / 1000);
    }
    
    function correctDateToNearestHalfHour(utcDate) {
        
        var min = utcDate.getMinutes();
        var h = utcDate.getHours();
        
        utcDate.setMinutes(0);
        
        if (min < 30)
            utcDate.setMinutes(30);
        else if (min <= 60)
            utcDate.setMinutes(60);
        
        return utcDate;
    }
    
    Date.prototype.addSeconds = function(s) {
        this.setSeconds(this.getSeconds() + s);
        return this;
    }
    
    function convertGMTStringToReadableFormat(GMTTimeString) {
        
        var t = GMTTimeString.match(/[\d\w]+/g);
        var months = {
            jan: '1',
            feb: '2',
            mar: '3',
            apr: '4',
            may: '5',
            jun: '6',
            jul: '7',
            aug: '8',
            sep: '9',
            oct: '10',
            nov: '11',
            dec: '12'
        };
        
        function pad(n) {
            return (n < 10 ? '0' : '') + +n;
        }
        
        function meridiem() {
            if (t[4] >= 12)
                return 'PM';
            else
                return 'AM';
        }
        
        function correctTo12HoursFormat() {
            var hrs = t[4] % 12;
            if (t[4] == 12)
                hrs = 12;
            return pad(hrs);
        }
        
        return months[t[2].toLowerCase()] + '/' + t[1] + '/' + t[3] + ' ' +
            correctTo12HoursFormat() + ':' + pad(t[5]) + ' ' + meridiem();
        
    }
    
