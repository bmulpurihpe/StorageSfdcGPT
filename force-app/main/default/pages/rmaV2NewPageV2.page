    function onCheckboxChange(elem,selectionClass,identity,identityValue,assetToProcess,componentType,srPart){
        // displayNote();
        var elems = document.getElementsByClassName(selectionClass);
        var currentState = elem.checked;
        var elemsLength = elems.length;
        for(i=0; i<elemsLength; i++)
        {
            if(elems[i].type === "checkbox")
            {
                elems[i].checked = false;   
            }
        }
        
        elem.checked = currentState;
        
        disableCheckboxesBasedOnPart(selectionClass);
        
        
        if(assetToProcess == 'Spares or Upgrades')
        {
            identity = assetToProcess;
        }
        
        
        if(assetName != assetToProcess || currentState == false)
        {
            onAssetChange(identity,identityValue,assetToProcess,currentState,componentType,srPart);
            assetName = assetToProcess;
        }
        else
        {
            onComponentTypeChange(identity,identityValue,assetToProcess,currentState,componentType,srPart);
        }
        
    }
    
    
    function disableCheckboxesBasedOnPart(selectionClass)
    {
        if(selectionClass == 'componentSelectionClass' )
        {
            selectionClass = 'assetSelectionClass';
        }
        else if(selectionClass  == 'assetSelectionClass')
        {
            selectionClass = 'componentSelectionClass';
        }
        
        var elems = document.getElementsByClassName(selectionClass);
        var elemsLength = elems.length;
        
        for(i=0; i<elemsLength; i++)
        {
            if(elems[i].type === "checkbox" && elems[i].checked === true)
            {
                elems[i].checked = false;   
            }
        }
    }
    
    //	Added By Exafort for TS-10592    
    /*
		This Logic is to hide the value 'System/part return' in the rmaType__c Picklist field for All the Profiles except 'NS-BusinessAdmin Support' on edit page.
        If the NSBusinessAdminSupportProfile is Null then 'System/part return' will not be hiden.
    */
    document.addEventListener('DOMContentLoaded', function() {
        var currentUserProfileId = '{!$User.ProfileId}';
        var NSBusinessAdminSupportProfile = '{!NSBusinessAdminSupportProfileId}'; 
        var currentRmaType = '{!RMAv2__c.rmaType__c}';
        // Get the picklist field values
        var rmaTypeValues = document.getElementById('Page:myForm:pageBlockID:generalInfo:rmaTypeId');
        if (rmaTypeValues) {
            // Loop through the options and hide the System/part return for user's profile not equal to NS-BusinessAdmin Support
            for (var i = 0; i < rmaTypeValues.options.length; i++) {
                if (rmaTypeValues.options[i].text == 'System/part return' && NSBusinessAdminSupportProfile != '' && NSBusinessAdminSupportProfile != currentUserProfileId && currentRmaType != 'System/part return') {
                    rmaTypeValues.remove(i);
                }
            }
        }
    });
