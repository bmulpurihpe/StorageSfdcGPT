                                                                <apex:inputField styleclass="form-control" onchange="writeSubject()" id="edit_eventType" value="{!editEventDetails.eventType__c}"/><br/>
                                                            </div>
                                                            <label for="edit_eventSubType" class="control-label col-sm-3">Sub Type:</label>
