                                                                    <apex:outputText id="allDayEventEndDateview"  value="{!allDayEndDateInString}" /><br/><br/>
                                                                </div>
                                                            </div>
                                                        </apex:outputPanel>
                                                        <apex:outputPanel rendered="{!IF(viewEventDetails.IsAllDayEvent == false, true, false)}">
                                                            <div id="disableFullDayEventview">
                                                                <label for="eventStartDate" class="control-label col-sm-3">Start Date/Time :</label>
                                                                <div class="col-sm-9">
                                                                    <apex:outputfield styleclass="form-control" id="eventStartDateview"  value="{!viewEventDetails.StartDateTime}"/><br/><br/>
                                                                </div>
                                                                <label for="eventEndDate" class="control-label col-sm-3">End Date/Time :</label>
