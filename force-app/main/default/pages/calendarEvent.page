                                                                <apex:input type="text" styleclass="form-control" id="edit_eventSubject" value="{!editEventSubject}"/><br/>
                                                            </div>
                                                            <label class="control-label col-sm-3">All-Day Event :</label>
                                                            <div class="col-sm-9">
                                                                <apex:inputField styleclass="form-control" onclick="allDayEventOnClickShowHideDate()" style="width: 18px;border-color: white;height: 16px;" id="edit_eventIsAllDayEvent" value="{!editEventDetails.IsAllDayEvent}"/><br/>
                                                            </div>
