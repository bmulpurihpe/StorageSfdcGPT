        <body>
            <div class="contextMenu" style="display:none" id="myMenu1">
                <ul>
                    <li id="edit">Edit</li>
                    <li id="cancel">Cancel</li>
                </ul>
            </div>
            <div class="contextMenu" style="display:none" id="myMenu2">
                <ul>
                    <li id="new" >New</li>
                    <li id="cancel">Cancel</li>
                </ul>
            </div>
            <apex:outputPanel id="calPanel">
                <apex:form id="theForm">
                    
                    <apex:actionFunction name="setEvnt" oncomplete="newButtonActionFunctions();" action="{!changeDate}" reRender="bootstrapDiv_New">
                        <apex:param value="" name="eventDate" assignTo="{!tempEventDate}"/>
                    </apex:actionFunction>
                    <apex:actionFunction name="editEventDetails" oncomplete="editButtonActionFunctions();" action="{!editEvent}" reRender="bootstrapDiv_Edit">
                        <apex:param value="" name="editEventId" assignTo="{!tempEventId}"/>
                    </apex:actionFunction>
                    <apex:actionFunction name="viewEventDetailsFun"  action="{!viewEvent}" oncomplete="viewalldayeventshowhide();" reRender="bootstrapDiv_view" >
                        <apex:param value="" name="viewEventId" assignTo="{!tempviewEventId}"/>
                    </apex:actionFunction>
                    <div id="cal-legend" >
                        <!--<apex:outputText rendered="{!if($Profile.Name !='Support: Technical Support Rep (TSR)',false,true)}"><center>Nimble Support Calendar</center></apex:outputText>-->
                        <apex:outputPanel rendered="{!if($Profile.Name !='Support: Technical Support Rep (TSR)',True,false)}">
                        <button id="newButton" class="fc-agendaWeek-button ui-button ui-state-default ui-corner-left ui-corner-right" type="button" data-toggle="modal" data-target="#myModal">New Event</button>
                        <button id="editButton" class="fc-agendaWeek-button ui-button ui-state-default ui-corner-left ui-corner-right" type="button" data-toggle="modal" data-target="#edit_Modal" style="display: none;">Edit Event</button>
                        <button id="viewButton" class="fc-agendaWeek-button ui-button ui-state-default ui-corner-left ui-corner-right" type="button" data-toggle="modal" data-target="#view_Modal" style="display: none;" >Event Detail</button>
                        </apex:outputPanel>
                        <br/><br/>
                        <apex:outputPanel >
                            <b><apex:outputText value="Filter by team : "/></b>
                            <apex:selectCheckboxes styleClass="teamsCheckboxesClass" value="{!teamListValues}">
                                <apex:actionSupport action="{!toggleTeamOrgEvents}" event="onchange" />
                                <apex:selectOptions id="teamCheckBoxValues" value="{!teamList}"/>
                            </apex:selectCheckboxes>
                            <b><apex:outputText value="Filter by organization : "/></b>
                            <apex:selectCheckboxes styleClass="orgsCheckboxesClass" value="{!organizationListValues}">
                                <apex:actionSupport action="{!toggleTeamOrgEvents}" event="onchange" />
                                <apex:selectOptions value="{!organizationList}"/>
                            </apex:selectCheckboxes><br/>
                            <apex:outputPanel rendered="{!if($Profile.Name !='Support: Technical Support Rep (TSR)',True,false)}">
                            <a href="/{!reportId}" style="text-decoration: none;" target="_blank">Current and Future Events</a>
                            </apex:outputPanel>
                        </apex:outputPanel>
                        <br/>
                        <hr/>
                        <table>
                            <tr>
                                <td style="background-color:#3366FF; width: 20px;"></td>
                                <td style="padding-left: 10px;">RTP</td>
                            </tr>
                            <tr>
                                <td style="background-color:#663399; width: 20px;"></td>
                                <td style="padding-left: 10px;">Minnesota</td>
