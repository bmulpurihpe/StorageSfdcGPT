                    <div class="bootstrap-iso">
                        <div class="container">
                            <!-- Trigger the modal with a button -->
                            <!-- Modal -->
                            <apex:outputPanel id="bootstrapDiv_New">
                                <!-- Start - For creation of new Event -->
                                <div class="modal fade centered-modal" id="myModal" role="dialog">
                                    <div class="modal-dialog">
                                        <!-- Modal content-->
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal"></button>
                                                <center><h4 class="modal-title">New Event</h4></center>
                                            </div> 
                                            <apex:actionRegion >
                                                <apex:pageMessages id="insideNewEventDiv"></apex:pageMessages>
                                                <div class="modal-body">
                                                    <form class="form-horizontal">
                                                        <div class="form-group">
                                                            <label for="eventAssignedTo" class="control-label col-sm-3">Create Event for :</label>
                                                            <div class="col-sm-8">
                                                                <apex:selectList onchange="UserRegionDisplay()" styleClass="form-control picklist" size="1" value="{!selectedname}">
                                                                    <apex:selectOptions id="UserOrRegion" value="{!items}"/>
                                                                </apex:selectList> <br/>
                                                            </div>
                                                            <div id="UserDisplay" >
                                                                <label for="eventAssignedTo" class="control-label col-sm-3"  >Assigned To :</label>
                                                                <div class="col-sm-9">
                                                                    <apex:inputfield styleclass="form-control lookupInput" id="eventAssignedTo" onchange="assignedToValueChange()" value="{!newEvent.OwnerId}"/><br/>
                                                                </div>
                                                            </div>
                                                            <div id="RegionDisplay" style="display:none;">
                                                                <label for="eventAssignedToRegion" class="control-label col-sm-3">Region :</label>
                                                                <div class="col-sm-9">
                                                                    <apex:inputfield styleclass="form-control" id="eventAssignedToRegion" OnChange="assignedToValueChange()" value="{!newEvent.Assigned_To_Region__c}"/><br/>
                                                                </div>
                                                            </div>
                                                            <label for="eventType"  class="control-label col-sm-3">Type :</label>
                                                            <div class="col-sm-9">
                                                                <apex:inputfield styleclass="form-control" onchange="writeSubject()" id="eventType" value="{!newEvent.eventType__c}" /><br/>
                                                            </div>
                                                            <label for="eventSubType"  class="control-label col-sm-3">Sub Type :</label>
                                                            <div class="col-sm-9">
                                                                <apex:inputfield styleclass="form-control" onchange="writeSubject()" id="eventSubType" value="{!newEvent.eventSubType__c}"/><br/>
                                                            </div>
                                                            <label for="eventSubject" class="control-label col-sm-3">Subject :</label>
                                                            <div class="col-sm-9">
                                                                <!--<apex:inputfield styleclass="form-control lookupInput" id="eventSubject" value="{!Event.Subject}"/><br/><br/>-->
                                                                <apex:input type="text" styleclass="form-control" id="eventSubject" value="{!eventSubject}"/><br/>
                                                            </div>
                                                            <label for="eventIsAllDayEvent" class="control-label col-sm-3">All-Day Event :</label>
                                                            <div class="col-sm-9">
