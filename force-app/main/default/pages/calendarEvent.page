                            <tr>
                                <td style="background-color:#FF9933; width: 20px;"></td>
                                <td style="padding-left: 10px;">HQ</td>
                            </tr>
                            <tr>
                                <td style="background-color:#CC0000; width: 20px;"></td>
                                <td style="padding-left: 10px;">APAC</td>
                            </tr>
                            <tr>
                                <td style="background-color:#669999; width: 20px;"></td>
                                <td style="padding-left: 10px;">EMEA</td>
                            </tr>
                            <tr>
                                <td style="background-color:#CC3399; width: 20px;"></td>
                                <td style="padding-left: 10px;">Weekend</td>
                            </tr>
                            <tr>
                                <td style="background-color:#996633; width: 20px;"></td>
