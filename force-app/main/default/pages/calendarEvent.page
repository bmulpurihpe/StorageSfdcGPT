                                                                <div class="col-sm-9">
                                                                    <div class="form-group">
                                                                        <div class="input-group date"  data-provide="datepicker" id="datetimepickerAllDayStart">
                                                                            <apex:inputText id="allDayEventStartDate" styleClass="form-control" value="{!new_allDayStartDateInString}" /><br/>
                                                                            <div class="input-group-addon" onclick="callDatePicker();"> <!--onclick="callDatePicker();"-->
                                                                                <span class="glyphicon glyphicon-th"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <label for="allDayEventEndDate" class="control-label col-sm-3">End Date :</label>
                                                                <div class="col-sm-9">
                                                                    <div class="form-group">
                                                                        <div class="input-group date"  id="datetimepickerAllDayEnd">
                                                                            <apex:inputText id="allDayEventEndDate" styleClass="form-control" value="{!new_allDayEndDateInString}" /><br/>
                                                                            <div class="input-group-addon" onclick="callDatePicker();"><!--onclick="callDatePicker();"-->
                                                                                <span class="glyphicon glyphicon-th" ></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div id="disableFullDayEvent">
                                                                <label for="eventStartDate" class="control-label col-sm-3">Start Date/Time :</label>
                                                                <div class="col-sm-9">
                                                                    <div class="form-group">
                                                                        <div class="input-group date" id="datetimepickerStartDateTime">
                                                                            <apex:inputText id="eventStartDate" styleClass="form-control" value="{!new_allDayStartDateTimeInString}" /><br/>
                                                                            <div class="input-group-addon" onclick="callDateTimePicker();"><!--onclick="callDatePicker();"-->
                                                                                <span class="glyphicon glyphicon-calendar"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <label for="eventEndDate" class="control-label col-sm-3">End Date/Time :</label>
