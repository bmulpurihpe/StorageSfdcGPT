                                                                    <div class="form-group">
                                                                        <div class="input-group date" id="datetimepickerEndDateTime">
                                                                            <apex:inputText id="eventEndDate" styleClass="form-control" value="{!new_allDayEndDateTimeInString}" /><br/>
                                                                            <div class="input-group-addon" onclick="callDateTimePicker();"><!--onclick="callDatePicker();"-->
                                                                                <span class="glyphicon glyphicon-calendar"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <!--Modified By vishnu to show Bootstap Date/Datetime picker on Feb 13th 2019 -- END -->
                                                            <div>
                                                                <label for="noteOrMemo"  class="control-label col-sm-3">Notes/Memo :</label>
                                                                <div class="col-sm-9">
                                                                    <apex:inputField value="{!newEvent.Description}" styleclass="form-control" id="noteOrMemo" /><br/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </apex:actionRegion>
                                            <div class="modal-footer" style="border-color:white;">
                                                <apex:commandButton id="saveEvent" styleClass="btn btn-primary" value="Save" action="{!saveNewEvent}" reRender="insideNewEventDiv"/>
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- End - For creation of new Event -->
                            </apex:outputPanel>
                            
                            <apex:outputPanel id="bootstrapDiv_Edit">
                                <!-- Start - For Editing an Event -->
                                <div class="modal fade centered-modal" id="edit_Modal" role="dialog">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal"></button>
                                                <center><h4 class="modal-title">Edit Event</h4></center>
