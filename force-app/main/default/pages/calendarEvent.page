                                                                <div class="col-sm-9">
                                                                    <div class="form-group">
                                                                        <div class="input-group date" data-provide="datepicker" id="editdatetimepickerAllDayStart">
                                                                            <apex:inputText id="edit_allDayEventStartDate" styleClass="form-control" value="{!allDayStartDateInString}" /><br/>
                                                                            <div class="input-group-addon" onclick="editDateOnclick();">
                                                                                <span class="glyphicon glyphicon-th" ></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <label for="edit_allDayEventEndDate" class="control-label col-sm-3">End Date :</label>
