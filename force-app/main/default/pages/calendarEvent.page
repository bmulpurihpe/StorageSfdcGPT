            <!--Commented by vishnu on Feb 13th 2019 -->
            <!--<link href="//cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.5.0/fullcalendar.print.css" rel="stylesheet" media="print"/>-->
            
            <!--For Full calendar CSS-->
            <link href="//code.jquery.com/ui/1.12.1/themes/cupertino/jquery-ui.css" rel="stylesheet" type="text/css"/>
            
            <!--For Bootstrap Datetime Picker CSS-->
            <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.37/css/bootstrap-datetimepicker.min.css" rel="stylesheet"/>
            
            <!--Commented by vishnu on Feb 13th 2019 -->
            <!--<apex:stylesheet value="{!URLFOR($Resource.bootstrapiso, 'bootstrap-iso/bootstrap-iso.css')}"/>-->
            
            <!--Boostrap CSS-->
            <apex:stylesheet value="{!URLFOR($Resource.bootstrapForCalendar, 'bootstrapisoCalendar/css/bootstrap-iso.css')}"/>
            <script>
            //debugger;            
            var previousOnload = window.onload;
            window.onload = function() 
            { 
                if (previousOnload) { 
                    previousOnload();
                } 
                var condition = true; // condition
                if(condition) {
                    document.getElementById("enableFullDayEvent").style.display = "none";
                    if(document.getElementById("thePage:theForm:eventAssignedTo").value == '' || document.getElementById("thePage:theForm:eventAssignedTo").value == null){
                        //document.getElementById("thePage:theForm:eventAssignedTo").value="{!$User.FirstName} {!$User.LastName}";
                        document.getElementById("thePage:theForm:eventAssignedTo").value="{!uname}";
                   }         
                }
            }
            </script>
            
            <script src="https://www.jqueryscript.net/demo/jQuery-Right-click-Menu-Plugin-ContextMenu/jquery.contextmenu.min.js" type="text/javascript">
            </script>
            
            <script type="text/javascript">
            //We need to wrap everything in a doc.ready function so that the code fires after the DOM is loaded
            $(document).ready(function(){
                //Call the fullCallendar method. You can replace the '#calendar' with the ID of the dom element where you want the calendar to go.
                $('#calendar').fullCalendar({
                    themeSystem: 'jquery-ui',
                    timezone: '{!userTimeZone}',
                    header: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'month, agendaWeek, agendaDay'
                    },
                    allDayDefault: true,
                    eventLimit: true,
                    events:
                    [
                        //At run time, this APEX Repeat will reneder the array elements for the events array
                        
                        
                       <apex:repeat value="{!listEvent}" var="lstEve"> 
                        <apex:repeat value="{!lstEve}" var="e">
                        {
                        title: "{!e.title}",
                        start: '{!e.startString}',
                        end: '{!e.endString}',
                        allDay: {!e.allDay},
                        url:'{!e.url}',
                        className: '{!e.className}',
                        eventType: '{!e.eventType}'
                        },
                        </apex:repeat>
                        </apex:repeat>
                       
                    ],
                    //Added to show Modal for Event Detail
                    eventClick: function(event) {
                        var eventUrl = event.url;
                        var arr = eventUrl.substr(1);
                        viewEventDetailsFun(arr);
                        return false;
                    },
                    eventRender: function (event, element) {
                        element.bind('mousedown', function (e) {
                            if (e.which == 3 && "{!JSENCODE($Profile.Name)}" != "Support: Technical Support Rep (TSR)") {
                                //Added for Right Click Menu on any Event - Start
                                $('.event-personal-rtp, .event-personal-minnesota, .event-personal-hq, .event-personal-apac, .event-personal-emea, .event-personal-weekend, .event-personal-bulletin,.event-personal-colorado,.event-other').contextMenu('myMenu1', {
                                    bindings: {
                                        'edit': function(t) {
                                            var eventUrl = event.url;
                                            var arr = eventUrl.substr(1);
                                            editEventDetails(arr);
                                        },
                                        'cancel': function(t) {
                                            return null;
                                        }
                                    }
                                });
                                //Added for Right Click Menu on any Event - End
                            }
                        });
                    },
                    dayRender: function (event, element) {
                        element.bind('mousedown', function (e) {
                            if (e.which == 3 && "{!JSENCODE($Profile.Name)}" != "Support: Technical Support Rep (TSR)") {
                                $('.fc-day').contextMenu('myMenu2', {
                                    bindings: {
                                        'new': function(t) {
                                            var v = event.format();
                                            setEvnt(v);
                                        },
                                        'cancel': function(t) {
                                            return null;
                                        }
                                    }
                                });
                                $('.ui-widget-content').contextMenu('myMenu2', {
                                    bindings: {
                                        'new': function(t) {
                                            var v = event.format();
                                            setEvnt(v);
                                        },
                                        'cancel': function(t) {
                                            return null;
                                        }
                                    }
                                });
                            }
                        });
                    }
                    //Can add some other event related things here
                });
                
            });
            </script>
            
            <script type="text/javascript">
            // debugger;
            
            function assignedToValueChange(){
                console.log('Inside 177');
                document.getElementById('thePage:theForm:eventSubject').value = '';
                document.getElementById('thePage:theForm:eventType').value = '';
                document.getElementById('thePage:theForm:eventSubType').value = '';
                document.getElementById('thePage:theForm:eventSubType').disabled=true;
            }
            
            function writeSubject(){
                
                var type = document.getElementById('thePage:theForm:eventType').value;
                var subType = document.getElementById('thePage:theForm:eventSubType').value;                
                var editType = document.getElementById('thePage:theForm:edit_eventType').value;

                
                var assignedTo = document.getElementById('thePage:theForm:eventAssignedTo').value;
                var assignedToRegion = document.getElementById('thePage:theForm:eventAssignedToRegion').value;
                var multiuserbutton = document.getElementById("multiuserevents");
                var childeventbutton = document.getElementById("childevents");
                // Added by Exafort for TS-9347
                var picklistVal = document.getElementsByClassName('form-control picklist')[0].value;
                
                if(type != 'Bulletin' && picklistVal == 'USER'){
                    if(assignedTo != null && assignedTo != '' && type != null && type != ''){
                        document.getElementById('thePage:theForm:eventSubject').value = assignedTo + ' ' + type + (subType != null && (subType.substring(0,1) != '_' && subType.length > 0 )  ? ' - ' + subType : '');
                    }
                }
                // Added by Exafort for TS-9512
                if(type != 'Bulletin' && picklistVal == 'REGION'){
                    if(assignedToRegion != null && assignedToRegion != '' && type != null && type != ''){
                        document.getElementById('thePage:theForm:eventSubject').value = assignedToRegion + ' ' + type + (subType != null && (subType.substring(0,1) != '_' && subType.length > 0 )  ? ' - ' + subType : '');
                    }
                }
                if(type == 'Bulletin'){
                    document.getElementById('thePage:theForm:eventSubject').value = '';
                }
                
                var editType = document.getElementById('thePage:theForm:edit_eventType').value;
                var editAssignedTo = document.getElementById('thePage:theForm:edit_eventOwnerId').value;
                var editSubType = document.getElementById('thePage:theForm:edit_eventSubType').value;                
               
                if(editType !='Bulletin'){
                    if(editAssignedTo != null && editType != null){
                        document.getElementById('thePage:theForm:edit_eventSubject').value = editAssignedTo + ' ' + editType + (editSubType != null && (editSubType.substring(0,1) != '_' && editSubType.length > 0 )  ? ' - ' + editSubType : '');
                    }
                }
                if(editType == 'Bulletin'){
                    document.getElementById('thePage:theForm:edit_eventSubject').value = '';
                }
            }
            
            function allDayEventOnClickShowHideDate(){
                var enablefulldayevent = document.getElementById("enableFullDayEvent");
                var isallDay = document.getElementById('thePage:theForm:eventIsAllDayEvent').checked;
                var hideStartAndEndDiv = document.getElementById('disableFullDayEvent');
                if(isallDay==true){
                    enablefulldayevent.style.display = "block";
                    hideStartAndEndDiv.style.display = "none";
                    // Added by Exafort for TS-4989
                    document.getElementById('thePage:theForm:allDayEventStartDate').value = new Date().toLocaleDateString();
                    // document.getElementById('thePage:theForm:allDayEventEndDate').value = new Date().toLocaleDateString();
                }
                else {
                    enablefulldayevent.style.display = "none";
                    hideStartAndEndDiv.style.display = "block";
                }
                
                var edit_enablefulldayevent = document.getElementById("edit_enableFullDayEvent");
                var edit_isallDay = document.getElementById('thePage:theForm:edit_eventIsAllDayEvent').checked;
                var edit_hideStartAndEndDiv = document.getElementById('edit_disableFullDayEvent');
                if(edit_isallDay==true){
                    //console.log('isAll Day True');
                    document.getElementById('thePage:theForm:edit_allDayEventEndDate').value = "";
                    edit_enablefulldayevent.style.display = "block";
                    edit_hideStartAndEndDiv.style.display = "none";
                }
                else {
                    edit_enablefulldayevent.style.display = "none";
                    edit_hideStartAndEndDiv.style.display = "block";
                }
            }
            function newButtonActionFunctions(){
                document.getElementById('newButton').click();
                if(document.getElementById("thePage:theForm:eventAssignedTo").value == '' || document.getElementById("thePage:theForm:eventAssignedTo").value == null){
                    // document.getElementById("thePage:theForm:eventAssignedTo").value="{!$User.FirstName} {!$User.LastName}";
                    document.getElementById("thePage:theForm:eventAssignedTo").value="{!uname}";
                }
                allDayEventOnClickShowHideDate();
                writeSubject();
                document.getElementById("thePage:theForm:eventSubject").value='';
                
            }
            //added by Exafort for event onclick
            function viewalldayeventshowhide(){
                viewButton.click();
            }
            // Added by Exafort for TS-9347
            function UserRegionDisplay(){
                var picklistVal = document.getElementsByClassName('form-control picklist')[0].value;
                if(picklistVal == "USER"){
                    var User = document.getElementById("UserDisplay");
                    User.style.display="block";
                    var Region = document.getElementById("RegionDisplay");
                    Region.style.display="none";
                }
                if(picklistVal == "REGION"){
                    var Region = document.getElementById("RegionDisplay");
                    Region.style.display="block";
                    var User = document.getElementById("UserDisplay");
                    User.style.display="none";
                }
            }
            // End of TS-9347
            function editButtonActionFunctions(){
                document.getElementById('editButton').click();
                //allDayEventOnClickShowHideDate();
                var Edit_enableFullDayEvent = document.getElementById("edit_enableFullDayEvent");
                var isallDay = document.getElementById('thePage:theForm:edit_eventIsAllDayEvent').checked;
                var hideStartAndEndDiv = document.getElementById('edit_disableFullDayEvent');
                if(isallDay==true){
                    Edit_enableFullDayEvent.style.display = "block";
                    hideStartAndEndDiv.style.display = "none";
                }
                else {
                    Edit_enableFullDayEvent.style.display = "none";
                    hideStartAndEndDiv.style.display = "block";
                }
            }
            
            </script>
            <script type="text/javascript">
            function callDatePicker(){
                $('#datetimepickerAllDayStart,#datetimepickerAllDayEnd').datetimepicker({
                    format: 'L'
                });
            }
            function callDateTimePicker(){
                $('#datetimepickerStartDateTime,#datetimepickerEndDateTime').datetimepicker({
                    format : 'MM/DD/YYYY hh:mm A'
                });
            }
            function editDateOnclick(){ 
                $('#editdatetimepickerAllDayStart,#editdatetimepickerAllDayEnd').datetimepicker({
                    format : 'L'
                });
            }
            function editDateTimeOnclick(){ 
                $('#editdatetimepickerStart,#editdatetimepickerEnd').datetimepicker({
                    format : 'MM/DD/YYYY hh:mm A'
                });
            }
            </script>
            
            <style>
