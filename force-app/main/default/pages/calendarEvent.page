                                                                    <apex:outputfield styleclass="form-control" id="eventEndDateview" value="{!viewEventDetails.EndDateTime}"/><br/><br/>
                                                                </div>
                                                            </div>
                                                        </apex:outputPanel>
                                                        <label class="control-label col-sm-3">Is Cancelled :</label>
                                                        <div class="col-sm-9">
                                                            <apex:outputField id="view_IsCancelled" value="{!editEventDetails.IsCancelled__c}" styleclass="form-control" style="width: 18px;border-color: white;height: 16px;"/><br/><br/>
                                                        </div>
                                                        <div>
                                                            <label for="noteOrMemo"  class="control-label col-sm-3">Notes/Memo :</label>
                                                            <div class="col-sm-9">
                                                                <apex:outputField value="{!viewEventDetails.Description}" styleclass="form-control" id="noteOrMemoview" /><br/><br/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                            <div class="modal-footer" style="border-color:white;">
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
