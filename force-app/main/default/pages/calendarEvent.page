                                                                    <div class="form-group">
                                                                        <div class="input-group date" data-provide="datepicker" id="editdatetimepickerAllDayEnd">
                                                                            <apex:inputText id="edit_allDayEventEndDate" styleClass="form-control" value="{!allDayEndDateInString}" /><br/>
                                                                            <div class="input-group-addon" onclick="editDateOnclick();">
                                                                                <span class="glyphicon glyphicon-th" ></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div id="edit_disableFullDayEvent">
                                                                <label for="edit_eventStartDate" class="control-label col-sm-3">Start Date/Time :</label>
                                                                <div class="col-sm-9">
                                                                    <div class="form-group">
                                                                        <div class="input-group date" id="editdatetimepickerStart">
                                                                            <apex:inputText id="edit_eventStartDate" styleClass="form-control" value="{!edit_allDayStartDateTimeInString}" /><br/>
                                                                            <span class="input-group-addon" onclick="editDateTimeOnclick();">
                                                                                <span class="glyphicon glyphicon-calendar"></span>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <label for="edit_eventEndDate" class="control-label col-sm-3">End Date/Time :</label>
                                                                <div class="col-sm-9">
                                                                    <div class="form-group">
                                                                        <div class="input-group date" id="editdatetimepickerEnd">
                                                                            <apex:inputText id="edit_eventEndDate" styleClass="form-control" value="{!edit_allDayEndDateTimeInString}" /><br/>
                                                                            <span class="input-group-addon" onclick="editDateTimeOnclick();">
                                                                                <span class="glyphicon glyphicon-calendar" ></span>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <!--Modified By vishnu to show Bootstap Date/Datetime picker on Feb 13th 2019 -- END -->
                                                            </div>
                                                            <label class="control-label col-sm-3">Is Cancelled :</label>
                                                            <div class="col-sm-9">
                                                                <apex:inputField id="Edit_IsCancelled" value="{!editEventDetails.IsCancelled__c}" styleclass="form-control" style="width: 18px;border-color: white;height: 16px;"/><br/>
                                                            </div>
                                                            <div>
                                                                <label class="control-label col-sm-3">Notes/Memo :</label>
                                                                <div class="col-sm-9">
                                                                    <apex:inputField id="edit_notesOrMemo" value="{!editEventDetails.Description}" styleclass="form-control"/><br/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </apex:actionRegion>
                                            <div class="modal-footer" style="border-color:white;">
                                                <apex:commandButton id="saveEditEvent" styleClass="btn btn-primary" value="Save" action="{!saveEditEvent}" reRender="insideEditEventDiv"/>
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
