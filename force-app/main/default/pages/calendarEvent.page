                                                                <div class="col-sm-9">
                                                                    <apex:outputText id="allDayEventStartDateview"  value="{!allDayStartDateInString}" /><br/><br/>
                                                                </div>
                                                                <label for="allDayEventEndDate" class="control-label col-sm-3">End Date :</label>
