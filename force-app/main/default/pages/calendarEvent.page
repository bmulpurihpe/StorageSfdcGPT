                            </apex:outputPanel>
                            
                            <!-- Start - For viewing an Event -->
                            <apex:outputPanel id="bootstrapDiv_view">
                                <div class="modal fade centered-modal" id="view_Modal" role="dialog">
                                    <div class="modal-dialog">
                                        <!-- Modal content-->
                                        <div class="modal-content">
