    }*/
    $(function(){
        
        $.widget( "custom.catcomplete", $.ui.autocomplete, {
            _create: function() {
                this._super();
                this.widget().menu( "option", "items", "> :not(.ui-autocomplete-category)" );
            },
            _renderItem: function (ul, item) {
                return $("<li>")
                .attr("data-value",item.subtecharea)
                .append(item.subtecharea)
                .appendTo(ul);
            },
            _renderMenu: function( ul, items ) {
                var that = this,
                    currentTechArea = "";
                $.each( items, function( index, item ) {
                    var li;
                    if ( item.techarea != currentTechArea ) {
                        ul.append( "<li class='ui-autocomplete-category'>" + item.techarea + "</li>" );
                        currentTechArea = item.techarea;
                    }
                    li = that._renderItemData( ul, item );
                    if ( item.techarea ) {
                        li.attr( "aria-label", item.techarea + " : " + item.subtecharea );
                    }
                });
            }
        });
        $.ajax({
            'async': true,
            'global': false,
            //'url': "{!URLFOR($Resource.techareasubtecharea, '/techandsubtechareacombinations.json')}",
            'dataType': "text",
            'success': function (data) {
                $("#search").catcomplete({
                    delay: 0,
                    source: {!fieldDependencies},
                    select: function (event, ui) {
                        $('#search').val(ui.item.techarea + " : " + ui.item.subtecharea);
                        
                        var techsubtech= $('#search').val();
                        if(techsubtech != null && techsubtech != ''){
                            var splitting = techsubtech.split(' : ');
                            takeTSAValue = splitting[1];
                            var controllingField = document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemTechArea:techArea');
                            /*controllingField.options.add( new Option(splitting[0],splitting[0]) );
                            controllingField.value = splitting[0];
                            controllingField.onchange();*/
                            var isFound = false;
                            for(i=0; i<controllingField.options.length;i++){
                                console.log(controllingField.options[i].value);
                                if(controllingField.options[i].value == splitting[0]){
                                    isFound = true;
                                }
                            }
                            if(isFound == false){
                                controllingField.options.add( new Option(splitting[0],splitting[0]) );
                            }
                            
                            controllingField.value = splitting[0];
                            controllingField.onchange();
                            /*if(controllingField.value == '' || controllingField.value == null){
                                alert('Selected Technical Area value is not available for the current record type');
                            }*/
                            //document.getElementById('thePage:theForm:pb:pbsection:subTechArea').value = splitting[1];
                            /*document.getElementById('thePage:theForm:pb:pbsection:subTechArea').options.add( new Option(splitting[1],splitting[1]) );
                            document.getElementById('thePage:theForm:pb:pbsection:subTechArea').value = splitting[1];*/
                            var isFoundTSA = false;
                            for(i=0; i<document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').options.length;i++){
                                console.log(document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').options[i].value);
                                if(document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').options[i].value == splitting[1]){
                                    isFoundTSA = true;
                                }
                            }
                            if(isFoundTSA == false){
                                document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').options.add( new Option(splitting[1],splitting[1]) );
                            }
                            document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value = splitting[1];
                            /*if(document.getElementById('thePage:theForm:pb:pbsection:subTechArea').value == '' || document.getElementById('thePage:theForm:pb:pbsection:subTechArea').value == null){
                                alert('Selected Sub-Technical Area value is not available for the current record type');
                            }*/
                            
                        }
                        return false;
                    },
                    response: function(event, ui) {
                        if (!ui.content.length) {
                            $('#noResults').show();
                            $("#message").text("No Suggestions Found");
                        } else {
                            $('#noResults').hide();
                            $("#message").empty();
                        }
                    }
                })
            }
            
        });
    })
    
    function bindValueFromSearch(){
        if(takeTSAValue != ''){
            document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value = takeTSAValue;
            if(document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value == ''){
                document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value = '--None--';
            }
        }
        if(takeTSAValue == null){
            document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value = '--None--';
        }
    }
    </script>
    <script>
    function techAreaOnchange(){
        if(document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemTechArea:techArea').value != null && document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value != null){
            if($('#search').val() != null){
                $('#search').val('');
            }
        }
    }
    function checkAuoComplete(){
        if($('#search').val() != null){
            var splitting = $('#search').val().split(' : ');
            document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value = splitting[1];
        }  
    }
    var getTechnicalArea;
    function dispatcherToCallActionFunction(){
        dispatchForTSALoad();
        if(document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemTechArea:techArea').value != null && document.getElementById('thePage:theForm:pb:pbsection:pbsectionItemSubTechArea:subTechArea').value != null){
            if($('#search').val() != null){
                $('#search').val('');
            }
        }
    }
    
    </script>
    <!-- Added by Exafort to show a pop-up modal -->
       <style>
        .popupBackground {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background-color: rgba(0,0,0,0.5);
        z-index: 1000;
        }
        .popupBox {
        width: 400px;
        margin: 20px auto 0 auto;
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0px 0px 10px #444;
        }
    </style>
    <!-- Ended by Exafort to show a pop-up Modal -->

    <!-- Script to hide modal -->
    <script>
    function confirmSave(){
        myCustomSave();
    }
    function hideModal() {
        const modal = document.querySelector('.popupBackground');
        if(modal) modal.style.display = 'none';
    }
    //Added by Exafort for SFDC-1153 - To show spinner on Save button click.
    function showSpinner() {
        document.getElementById('spinnerWrapper').style.display = 'block';
    }

    function hideSpinner() {
        
        document.getElementById('spinnerWrapper').style.display = 'none';
    }
    //END SDFC-1153
    
    </script>
</apex:page>