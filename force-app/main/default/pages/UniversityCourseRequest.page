                    <apex:outputPanel id="pnlDesireCourseStartDate">{!$ObjectType.University_Course_Request__c.fields.Desired_Course_Start_Date__c.Label}</apex:outputPanel>
                    <apex:outputPanel >
                        <div class="reqBlock2"></div>
                        <apex:inputField value="{!ucr.Desired_Course_Start_Date__c}" id="iptDesiredDate" styleClass="" >
