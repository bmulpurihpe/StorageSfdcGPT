                <!-- <apex:commandButton action="{!Save}" value="Savetest2" oncomplete="if({!isValidate}) {alert('a');return false;} else {alert('b');return false;}"/> -->
                <!-- <apex:commandButton action="{!doSave}" value="Save" oncomplete="window.top.location='/{!ucr.id}'; return false"/> -->
                <!-- <apex:commandButton value="SaveRecord" onclick="SaveRecord()" oncomplete="Test()"/> -->
                <!-- <apex:commandButton action="{!SaveNew}" value="Save & New"/> -->
                <apex:commandButton action="{!Cancel}" value="Cancel" immediate="true"/>
