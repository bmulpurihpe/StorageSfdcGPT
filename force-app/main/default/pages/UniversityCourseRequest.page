    <style type="text/css">
        .firstLbl,.secondLbl
        {
            /*text-align:right;
            display:block;*/
        }
        .bPageBlock .detailList .dataCol
        {
            width:25%;
        }
        .requestInstructor select, .ddlHidden select
        {
            display:none;
        }
        
        .setLookup
        {
            float: left;
        }
        
        .stylebtnClear
        {
            margin-top: -1px;
            font-size: 9px;
            width: 35px;
            float: left;
        }
        
        .tooltips
        {       
            font-weight: normal;
            font-style: italic;
            font-size:10px;     
        }
        div.reqBlock
        {
            background-color: #c00;
            left:-4px;
            width:3px;
            top:1px;
            bottom:1px;
            height:30px;
            float:left;
        }
        div.reqBlock2
        {
            background-color: #c00;
            left:-4px;
            width:3px;
            top:1px;
            bottom:1px;
            height:18px;
            float:left;
            margin-right:1px;
        }
        div.reqBlock3
