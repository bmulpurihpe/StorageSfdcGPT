                        <apex:outputText value="{!errStartDate}" styleClass="errorMsg" rendered="{!LEN(errStartDate)>0}"/>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                
                <apex:outputField value="{!ucr.ownerID}" id="optOwner" styleClass="secondInput"/>
                
                <apex:pageBlockSectionItem >
                    <apex:outputPanel >{!$ObjectType.University_Course_Request__c.fields.Course_Request_Response_SLA__c.Label}</apex:outputPanel>
