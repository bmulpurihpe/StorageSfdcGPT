            width:150%;
        }
        .errorMsg
        {
            display: block;
        }
        .pbError
        {
            display: inherit;
        }
        
    </style>
    <script type="text/javascript">
        //document.domain = "c.cs40.visual.force.com";
        function SaveRecord()
        {
            //alert("Hello");
            save();
            alert("This is save record");
        }
        function Test()
        {
            var isValidate = document.getElementById("thePage:varFrm:isValidate").value;
            alert(isValidate);
            var ucrId = document.getElementById("thePage:varFrm:ucrId").value;
            alert(ucrId);
            //window.top.location='/{!ucr.id}';
        }
        
        function ClearText(eId){
            document.getElementById(eId).value = '';
            document.getElementById(eId+'_lkid').value = '';
        }
        
        function disableAll(){
            //document.getElementById("thePage:frm:pb:ciBlock:pbsecRequestInstructor:iptRequestInstructor").disabled=true;
            //document.getElementById("thePage:frm:pb:ciBlock:pbsecSecondInstructor:iptSecondInstructor").disabled=true;
            //document.getElementById("thePage:frm:pb:ciBlock:pbsecInstructorTraining:iptInstructorTraining").disabled=true;
            document.getElementById("thePage:frm:pb:ciBlock:pbsecRequestInstructor:iptReqUniverInstructor").disabled=true;
            document.getElementById("thePage:frm:pb:ciBlock:pbsecSecondInstructor:ipt2ndUniverInstructor").disabled=true;
            document.getElementById("thePage:frm:pb:stBlock:pbsecAEName:iptAEName").disabled=true;
            document.getElementById("thePage:frm:pb:stBlock:pbsecSEName:iptSEName").disabled=true;
        }
        window.onload=function(){
            disableAll();
        }
    </script>
    <apex:form id="varFrm" >
        <apex:actionFunction name="astVenueSelected" action="{!astVenueSelected}"/>
        <apex:actionFunction name="save" action="{!doSave}"/>
        <apex:inputHidden value="{!isValidate}" id="isValidate"/>
        <apex:inputHidden value="{!ucr.Id}" id="ucrId"/>
    </apex:form>
    
    <apex:form id="frm">
        <apex:outputPanel rendered="{!refreshPage}">
           <script>
                window.top.location='/{!ucr.id}';
           </script>
        </apex:outputPanel> 
