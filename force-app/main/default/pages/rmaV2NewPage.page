<apex:page standardcontroller="RMAv2__c" id="Page" extensions="rmav2ExtensionsWithSharingNew">
<script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"></script>
<script> function setFocusOnLoad() {} </script>
<script type="text/javascript">


var returnSection;
        $(document).ready(function() {

            var overrideAccountName = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideAccountNameId');
            if(overrideAccountName.value != '')
            {
                document.getElementById('divAccountNameId').innerText = overrideAccountName.value;
                document.getElementById('divAccountNameId').style.color = 'blue';
            }
        
            var overrideStreet1 = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideStreet1Id');
            if(overrideStreet1.value != '')
            {
                document.getElementById('divStreet1Id').innerText = overrideStreet1.value;
                document.getElementById('divStreet1Id').style.color = 'blue';
            }
               
            var overrideStreet2 = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideStreet2Id');
            if(overrideStreet2.value != '')
            {
                document.getElementById('divStreet2Id').innerText = overrideStreet2.value;
                document.getElementById('divStreet2Id').style.color = 'blue';
            }
            
            var overrideCity = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideCityId');
            if(overrideCity.value != '')
            {
                document.getElementById('divCityId').innerText = overrideCity.value + ', ';
                document.getElementById('divCityId').style.color = 'blue';
            }
            
            var overrideState = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideStateId');
            if(overrideState.value != '')
            {
                document.getElementById('divStateId').innerText = overrideState.value;
                document.getElementById('divStateId').style.color = 'blue';
            }
            
            var overridePostalCode = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overridePostalCodeId');
            if(overridePostalCode.value != '')
            {
                document.getElementById('divPosalCodeId').innerText = overridePostalCode.value;
                document.getElementById('divPosalCodeId').style.color = 'blue';
            }
            
            var overrideCountry = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideCountryId');
            if(overrideCountry.value != '')
            {
                document.getElementById('divCountryId').innerText = overrideCountry.value;
                document.getElementById('divCountryId').style.color = 'blue';
            }
            
            var overrideAttn = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideAttnId');
            if(overrideAttn.value != '')
            {
                document.getElementById('divAssetContactId').innerText = 'Attn: ' +  overrideAttn.value;
                document.getElementById('divAssetContactId').style.color = 'blue';
            }
            
            var overridePhone = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overridePhoneId');
            if(overridePhone.value != '')
            {
                document.getElementById('divContactPhoneId').innerText = 'Contact Phone: ' + overridePhone.value;
                document.getElementById('divContactPhoneId').style.color = 'blue';
            }
            
            var overrideEmail = document.getElementById('Page:myForm:pageBlockID:rmaShipmentAddressId:overrideEmailId');
            if(overrideEmail.value != '')
            {
                document.getElementById('divContactEmailId').innerText = 'Contact Email: ' + overrideEmail.value;
                document.getElementById('divContactEmailId').style.color = 'blue';
            }
            
            
            showOrHideHddSsdSerialNumber(document.getElementById('Page:myForm:pageBlockID:pageBlockSectionHddSsdId:hddSsdSerialNumberId'));
            showOrHideReturnSections(document.getElementById('Page:myForm:pageBlockID:partSelectionSectionId:rmaComponentId').value);

            
        });
        
        function showOrHideHddSsdSerialNumber(hddSsdSerialNumber)
        {
           var component = document.getElementById('Page:myForm:pageBlockID:partSelectionSectionId:rmaComponentId').value;
           
           if(component == 'HDD' || component == 'SSD' )
              $(hddSsdSerialNumber).parent().parent().show();
           else
              $(hddSsdSerialNumber).parent().parent().hide();
           
        }
        

        function showOrHideReturnSections(component)
        {
              var showReturnSection = document.getElementById('Page:myForm:pageBlockID:hideorShowSectionsVariablesId:rmaShowReturnSectionsAlwaysId').checked;              
              var assetNrdIsInEffect = document.getElementById('Page:myForm:pageBlockID:assetNrdIsInEffectFlag');              
              var ReturnShipmentInfoSectionId = document.getElementById('Page:myForm:pageBlockID:returnShipmentSectionId');              
              var returnShipmentPanelId = document.getElementById('Page:myForm:pageBlockID:returnShipmentPanelId');
              
              if(showReturnSection == false)
              {

                  if(((component == 'HDD' || component == 'SSD') && assetNrdIsInEffect.value == 'true') || (component == 'BEZEL' || component == 'CABLE' || component == 'CORD (power cord)' || component == 'DONGLE' || component == 'RAILS' ))
                  {
                        if(ReturnShipmentInfoSectionId != null)
                            returnSection = $(ReturnShipmentInfoSectionId).detach();
                  }
                  else
                  {
                     if(returnSection != null)
                     {
                         returnSection.appendTo(returnShipmentPanelId);
                         returnSection = null;
                         reloadReturnSections();
                     }
                  }
              }
              else
              {
                     if(returnSection != null)
                     {
                         returnSection.appendTo(returnShipmentPanelId);
                         returnSection = null;
                         reloadReturnSections();
                     }
              }     
        }

         function onCaseNumberChange() {
            var componentName = document.getElementById('Page:myForm:pageBlockID:partSelectionSectionId:rmaComponentId');
            caseNumberParam(componentName.value);
        }
        
        function onDiskShelfChange() {
            var componentName = document.getElementById('Page:myForm:pageBlockID:partSelectionSectionId:rmaComponentId');
            diskShelfParam(componentName.value);
        }

        
        function onComponentChange(component){  
              var hddSsdSerialNumber = document.getElementById('Page:myForm:pageBlockID:pageBlockSectionHddSsdId:hddSsdSerialNumberId');
              hddSsdSerialNumber.value = '';
              showOrHideHddSsdSerialNumber(hddSsdSerialNumber);
              showOrHideReturnSections(component);
        }
                        
                        
        function overrideShipmentLabelDetail(currentOverrideFieldId, currentShipmentLabelFieldId,currentFieldTag,oldShipmentFieldValue){
            var fieldToOveride = document.getElementById(currentShipmentLabelFieldId);   
            var overidenFieldValue = document.getElementById(currentOverrideFieldId);
        
            if(overidenFieldValue.value == '')
            { 
                fieldToOveride.innerText = oldShipmentFieldValue;
                fieldToOveride.style.color = 'black';
            }
            else
            {
               if(overidenFieldValue.value != oldShipmentFieldValue)
               {
                    if(currentOverrideFieldId == 'Page:myForm:pageBlockID:rmaShipmentAddressId:overrideCityId')
                          fieldToOveride.innerText = currentFieldTag + overidenFieldValue.value + ', ';
                    else
                          fieldToOveride.innerText = currentFieldTag + overidenFieldValue.value;
                
                    fieldToOveride.style.color = 'blue';
               }
               else
               {
                  fieldToOveride.innerText = oldShipmentFieldValue;
                  fieldToOveride.style.color = 'black';
               }
            }
        }
        
        function checkReturnSections()
        {
           showOrHideReturnSections(document.getElementById('Page:myForm:pageBlockID:partSelectionSectionId:rmaComponentId').value);
        }
        
        function onFaRequiredChange()
        {
           var faRequired = document.getElementById('Page:myForm:pageBlockID:generalInfo:faRequiredId').value;
           actionFaRequiredOnChange(faRequired);
        }
        
     
   
</script>


    <apex:sectionheader title="{!$ObjectType.RMAv2__c.label} Edit" subtitle="{!IF(ISNULL(RMAv2__c.Name), 'New RMAv2',RMAv2__c.Name)}"/>

    <apex:form id="myForm" >

     <apex:pageMessages id="PM2" escape="false"/>
        
