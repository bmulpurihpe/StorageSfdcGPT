                               <apex:param name="componentName"  value=""/>
                            </apex:actionFunction>
                        </apex:inputField>
                        
                         <apex:inputField value="{!RMAv2__c.rmaFaRequired__c}" id="faRequiredId" onchange="onFaRequiredChange()"  required="true" >
                             <apex:actionFunction name="actionFaRequiredOnChange" immediate="true" action="{!faRequiredOnChange}" reRender="outPanelEFAPriority">
                                <apex:param name="rmaFaRequired" value="" />
                         </apex:actionFunction>
                        </apex:inputField>

                     </apex:pageblocksection>
                      
                      <apex:outputPanel id="outPanelEFAPriority">
