<apex:page id="clearingAttnReq" standardController="Case" Extensions="CaseClearAttnReqController" action="{!caseClearAttnReq}">
    
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"></script>
    <script> 
        $(document).ready(function() {
        setSendCustomerNotification();
    });
    function setSendCustomerNotification() {
        var publicValue = document.getElementById('clearingAttnReq:form:block:commentDetails:public');
        var customerNotification = document.getElementById('clearingAttnReq:form:block:commentDetails:sendCustomerNotification');
        if(publicValue.checked){
            customerNotification.disabled = false; 
            customerNotification.checked = true;
        }
        else{
            customerNotification.checked = false;
            customerNotification.disabled = true; 
        }
        
    }
    </script>
    
    <apex:sectionheader title="Clearing Attn Required">    
        <apex:form id="form">
            <apex:pageblock title="Case {!cas.CaseNumber}" id="block" mode="Edit">
                <apex:pageMessages />
                <apex:pageblockbuttons >
                    <apex:commandbutton value="Save"  action="{!saveCaseComment}" disabled="{!saveButtonDisable}"/> 
                    <button class="btn" style="padding:4px;" onclick="window.open('/{!$currentpage.parameters.id}', target='_self');return false;">Cancel</button>
                </apex:pageblockbuttons>
                <apex:outputPanel id="pb">
                    <apex:pageBlockSection Id="caseInformation" columns="1" showHeader="true" Title="Case Details">
                        <apex:outputfield value="{!cas.ownerId}"/>
                        <apex:outputfield value="{!cas.Subject}"/>
                        <apex:outputfield value="{!cas.Description}"/>
                    </apex:pageBlockSection>                
                    <apex:pageblocksection id="commentDetails" title="Comment Details" columns="1" collapsible="False" rendered="{!if(saveButtonDisable==true,false,true)}">
                        <apex:inputfield value="{!cas.Status}"/>
                        <apex:inputCheckbox id="public" label="Public" value="{!caseCommentIsPublished}" onchange="setSendCustomerNotification()"/>
                        <apex:inputCheckbox id="sendCustomerNotification" label="Send Customer Notification" value="{!caseCommentIsNotified}" />
                        <apex:inputfield value="{!cas.Current_comment_time_spent__c}"/>
                        <apex:inputTextarea label="Comment" value="{!caseCommentBody}" Required="True" style="width: 460px; height: 100px" />
                    </apex:pageblocksection>
                </apex:outputPanel>
            </apex:pageblock>
        </apex:form>
    </apex:sectionheader>
</apex:page>