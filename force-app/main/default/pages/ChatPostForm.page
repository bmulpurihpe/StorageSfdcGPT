<apex:page controller="ChatFeedbackController" showHeader="false" standardStylesheets="false">
    <style>
            .startchat_submit {
              background-color: white; /* Green */
              border: none;
              color: black;
              padding: 15px 32px;
              text-align: center;
              text-decoration: none;
              display: inline-block;
              font-size: 16px;
              margin: 4px 2px;
              cursor: pointer;
              border: 3px solid #c2d8d6;
            }
    </style>
        
    <apex:slds />
    <apex:form id="frm"> 
       <apex:outputPanel id="op1" rendered="{!!hidefeedback}">
       <!-- <apex:inputText id="chatfeedbackName" value="{!feedbackName}" /> -->
        <table style="margin-left : 20px;">
            <tr>
            	<td style="padding : 3px;" >1. How would you rate your chat consultant today?</td>
            </tr>
            <tr>
            	<td style="padding : 3px;">
                    <apex:selectList size="1" value="{!feedback.How_would_you_rate_your_chat_consultant__c}">
                    	<apex:selectOptions value="{!picklist1}"></apex:selectOptions>
                    </apex:selectList>
                	<!-- <apex:inputField value="{!feedback.How_would_you_rate_your_chat_consultant__c }"/> -->
                </td>
            </tr>
            
            
            <tr>
            	<td style="padding : 5px;">2. Was your question resolved by the consultant today</td>
            </tr>
            <tr>
            	<td>
                    <apex:selectList size="1" value="{!feedback.Was_your_question_resolved_by_the_consul__c}">
                    	<apex:selectOptions value="{!picklist5}"></apex:selectOptions>
                    </apex:selectList>
                    <!--
                	<apex:inputField value="{!feedback.Was_your_question_resolved_by_the_consul__c}"/> -->
                </td>
            </tr>
            <tr>
            	<td style="padding : 5px;">3. Please provide any suggestions or feedback regarding your chat experience</td>
            </tr>
            <tr>
            	<td>
                    <apex:inputtextarea value="{!feedback.surveyCustomerComments__c}"/>
                </td>
            </tr>
            <tr>
            	<td style="padding : 10px;">
                    <apex:commandButton styleClass="slds-button slds-button--brand" value="Submit" action="{!createFeedback}" reRender="frm
                                                                                                                                                         "/>
                </td>
            </tr>
            
        </table>
</apex:outputPanel>                                                                                                                                                                                                                                                                           
        <apex:outputPanel id="op2" rendered="{!hidefeedback}" > 
        	<div style="margin-left:20px;">
                
                Your reference number for this chat session is <b>{!caseNumber}</b>
                <br/><br/>
                
            <div>
                {!liveAgentName} Consultant has joined this session!
                <p>
                    <b>{!liveAgentName},</b> HPE Consultant<br/><br/>                    
                </p>
            </div>
            
                <center>
            <div style="margin-top:100px;">
                <apex:commandButton value="START A NEW CHAT" id="startchat_submit" styleClass="startchat_submit" action="{!startNewChat}" />
            </div>
               </center>     
            </div>
        </apex:outputPanel>
    </apex:form>
</apex:page>