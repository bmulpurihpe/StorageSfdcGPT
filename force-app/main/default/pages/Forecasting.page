<apex:page showHeader="true" sidebar="false" controller="ForecastingController" extensions="ForecastingStatsService" action="{!setupForecast}" tabStyle="Forecasting__tab">
    <script src="{!URLFOR($Resource.Forecasting, 'js/jquery.min.js')}"></script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/jquery.ba-throttle-debounce.min.js')}"></script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/angular.min.js')}"></script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/bootstrap.min.js')}"></script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/angular-animate.min.js')}"></script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/ngStorage.js')}"></script>
    <apex:stylesheet value="{!URLFOR($Resource.Forecasting, 'css/fq.css')}" />
    <apex:stylesheet value="{!URLFOR($Resource.Forecasting, 'css/bootstrap-iso.css')}" />
    <script src="{!URLFOR($Resource.Forecasting, 'js/jquery.stickyheader.js')}"></script>
    <link href="//netdna.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" />
    <!-- <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.Forecasting, 'css/sticky.css')}" /> -->

    <script type="text/javascript">
        var forecastEditable = true;
        var forecastEnabled = {!CurrentViewingUser.ForecastEnabled == true};
        var fiscalQtr = "{!CurrentFiscalQuarter.FormattedString}";
        var currentWeek = "{!CurrentWeek.FormattedString}";
        var weeks = {!CurrentFiscalQuarter.JsonWeeks};
        var startDate = "{!CurrentFiscalQuarter.StartDate}";
        var endDate = "{!CurrentFiscalQuarter.EndDate}";
        var currentViewingUserId = "{!CurrentViewingUser.UserId}";
        var userPath = "{!UserPath}";
        var forecastLevel = "{!CurrentViewingUser.ForecastLevel}";
    </script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/forecast.js')}"></script>
    <script src="{!URLFOR($Resource.Forecasting, 'js/load-forecast.js')}"></script>

    <apex:sectionHeader title="Forecasting" subTitle="{!CurrentFiscalQuarter.FormattedString} - {!CurrentViewingUser.UserName}" />
    <apex:PageMessages id="pageMessage" escape="true" />

    <apex:form id="form">
        <div id="ngContainer" ng-app="forecastingApp" ng-controller="forecastingCtrl">
            <div class="ptBreadcrumb"><span class="fa fa-user"></span>
                <apex:variable var="p" value="" />
                <apex:repeat value="{!UserNavPath}" var="usr">
                    <apex:variable var="p" value="{!p + '/' + usr.UserId}" />
                    <a href="{!$Page.Forecasting}?path={!p}&quarter={!CurrentFiscalQuarter.FormattedString}">{!usr.UserName}</a> &gt;
                </apex:repeat>
                <span style="margin-left:30%;color:red;" ng-show="requestInProgress>0">Loading...</span>
                <span style="color:red;" ng-show="errorMessage != null">{{errorMessage}}</span>
            </div>      
            <br/>
            <div id="wrap">
                <div class="fqTitleCon">
                    <span class="fqTitle">Fiscal Quarter</span>
                    <span class="fqNum">{!CurrentFiscalQuarter.FormattedString}</span>
                    <a class="fqBtn" href="{!$Page.Forecasting}?quarter={!CurrentFiscalQuarter.Previous.FormattedString}&path={!UserPath}" title="Previous quarter"><img src="{!URLFOR($Resource.Forecasting, 'img/fqBtnLeft.gif')}" /></a>
                    <a class="fqBtn" href="{!$Page.Forecasting}?quarter={!CurrentFiscalQuarter.Next.FormattedString}&path={!UserPath}" title="Next quarter"><img src="{!URLFOR($Resource.Forecasting, 'img/fqBtnRight.gif')}" /></a>
                    <span class="displayUnits">
                        <input type="radio" name="displayUnits" id="displayUnitsM" value="M" ng-click="displayFormat='M'" /><label for="displayUnitsM">Millions</label>
                        <input type="radio" name="displayUnits" id="displayUnitsK" value="K" ng-click="displayFormat='K'" /><label for="displayUnitsK">Thousands</label>
                        <input type="radio" name="displayUnits" id="displayUnitsW" value="W" checked="true" ng-click="displayFormat='W'" /><label for="displayUnitsW">Whole</label>
                        <input type="radio" name="displayUnits" id="displayUnitsE" value="E" ng-click="displayFormat='E'" /><label for="displayUnitsE">Exact</label>
                    </span>
                    <span class="toolButtons">
                        <a class="toolBtn fa fa-bar-chart" href="javascript:void(0)" ng-click="openChart()" title="Open trending chart" style="color: #319431;"></a>
                        <!-- <input type="checkbox" name="displayQ" id="displayQ" ng-model="showQuota" ng-click="toggleQuota(showQuota)" /><label for="displayQ">Show Quota</label>-->
                        <a class="toolBtn fa fa-dot-circle-o" id="quotaToggleBtn" href="javascript:void(0)" ng-click="toggleQuota()" title="Show Quota" style="color: red"></a>
                    </span>
                </div>
            </div>
        
            <!---------- Forecast Summary Section ---------->
            <apex:pageBlock id="summaryBlock" title="Your Weekly Forecast Metrics" rendered="{!CurrentViewingUser != null && CurrentViewingUser.ForecastEnabled}">
                <!--<img src="{!URLFOR($Resource.Forecasting, 'img/loading7.gif')}" ng-show="forecastSummary.data.WeeklyForecasts.length == 0" alt="Loading..." width="80" />-->
                <table class="report sticky" ng-show="forecastSummary.data.WeeklyForecasts.length > 0">
                    <thead>
                        <tr class="center">
                            <th class="noBd sticky"></th>
                            <td ng-repeat="w in weeks" class="noBd">{{w.FormattedShortString}}</td>
                        </tr>
                        <tr class="header">
                            <th class="W150 sticky">Forecast Metrics</th>
                            <th ng-class="{'W80': !w.Editable, 'W100': w.Editable, 'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">Week {{$index+1}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="line quota" style="display:none"><!-- line display is controlled by checkbox and in JS -->
                            <td class="center sticky">Quota</td>
                            <td class="number" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'Quota__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['Quota__c'].length > 0" ng-repeat="h in w.Histories['Quota__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['Quota__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" title="Edit" ng-hide="forecastSummary.isEditing" ></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.Quota" />
                                    <span ng-hide="forecastSummary.isEditing">{{formatDecimal(forecastSummary.data.Quota, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && requestInProgress == 0">{{formatDecimal(w.Quota, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">CQ Bookings</td>
                            <td class="number" ng-repeat="w in forecastSummary.data.WeeklyForecasts">{{formatDecimal(w.QtrBooking, displayFormat)}}</td>
                        </tr>
                        <tr>
                            <td class="noBd sticky">&nbsp;</td>
                            <td colspan="13" class="noBd">&nbsp;</td>
                        </tr>
                        <tr class="line" ng-show="isManager">
                            <td class="center sticky">C9 Projection</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'C9_Projection__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['C9_Projection__c'].length > 0" ng-repeat="h in w.Histories['C9_Projection__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['C9_Projection__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="isManager && w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" title="Edit" ng-hide="forecastSummary.isEditing" ></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.C9Projection" />
                                    <span ng-hide="forecastSummary.isEditing">{{formatDecimal(forecastSummary.data.C9Projection, displayFormat)}}</span>
                                </span>
                                <span ng-hide="isManager && w.Editable && forecastEditable && requestInProgress == 0">{{formatDecimal(w.C9Projection, displayFormat)}}</span>
                            </td>
                        </tr>
                        
                        <tr class="line2">
                            <td class="center sticky">CQ Commit</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'QuarterCommit__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['QuarterCommit__c'].length > 0" ng-repeat="h in w.Histories['QuarterCommit__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['QuarterCommit__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" title="Edit" ng-hide="forecastSummary.isEditing" ></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.QtrCommit" />
                                    <span ng-hide="forecastSummary.isEditing" ng-class="{'f-red': w.QtrCommitDown, 'f-green': w.QtrCommitUp}">{{formatDecimal(forecastSummary.data.QtrCommit, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && requestInProgress == 0" ng-class="{'f-red': w.QtrCommitDown, 'f-green': w.QtrCommitUp}">{{formatDecimal(w.QtrCommit, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line">
                            <td class="center sticky">CQ Gut</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'QuarterGut__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['QuarterGut__c'].length > 0" ng-repeat="h in w.Histories['QuarterGut__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['QuarterGut__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.QtrGut" />
                                    <span ng-hide="forecastSummary.isEditing" ng-class="{'f-red': w.QtrGutDown, 'f-green': w.QtrGutUp}">{{formatDecimal(forecastSummary.data.QtrGut, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && requestInProgress == 0" ng-class="{'f-red': w.QtrGutDown, 'f-green': w.QtrGutUp}">{{formatDecimal(w.QtrGut, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">CQ Upside</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'QuarterUpside__c')" ng-hide="forecastSummary.isEditing"><div class="history-tooltip">
                                        <div ng-show="w.Histories['QuarterUpside__c'].length > 0" ng-repeat="h in w.Histories['QuarterUpside__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['QuarterUpside__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.QtrUpside" />
                                    <span ng-hide="forecastSummary.isEditing" ng-class="{'f-red': w.QtrUpsideDown, 'f-green': w.QtrUpsideUp}">{{formatDecimal(forecastSummary.data.QtrUpside, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && requestInProgress == 0" ng-class="{'f-red': w.QtrUpsideDown, 'f-green': w.QtrUpsideUp}">{{formatDecimal(w.QtrUpside, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="14" class="noBd">&nbsp;</td>
                        </tr>
                        <tr class="line">
                            <td class="center sticky">Month 1 Commit</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'Month1Commit__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['Month1Commit__c'].length > 0" ng-repeat="h in w.Histories['Month1Commit__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['Month1Commit__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && forecastSummary.data.CurrentMonthIndex== 1 && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.Month1Commit" />
                                    <span ng-hide="forecastSummary.isEditing">{{formatDecimal(forecastSummary.data.Month1Commit, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && forecastSummary.data.CurrentMonthIndex == 1 && requestInProgress == 0">{{formatDecimal(w.Month1Commit, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">Month 2 Commit</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'Month2Commit__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['Month2Commit__c'].length > 0" ng-repeat="h in w.Histories['Month2Commit__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['Month2Commit__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && forecastSummary.data.CurrentMonthIndex <= 2 && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.Month2Commit" />
                                    <span ng-hide="forecastSummary.isEditing">{{formatDecimal(forecastSummary.data.Month2Commit, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && forecastSummary.data.CurrentMonthIndex <= 2 && requestInProgress == 0">{{formatDecimal(w.Month2Commit, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line">
                            <td class="center sticky">Month 3 Commit</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'Month3Commit__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['Month3Commit__c'].length > 0" ng-repeat="h in w.Histories['Month3Commit__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['Month3Commit__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && forecastSummary.data.CurrentMonthIndex <= 3 && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.Month3Commit" />
                                    <span ng-hide="forecastSummary.isEditing">{{formatDecimal(forecastSummary.data.Month3Commit, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && forecastSummary.data.CurrentMonthIndex <= 3 && requestInProgress == 0">{{formatDecimal(w.Month3Commit, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">Total</td>
                            <td class="number" ng-repeat="w in forecastSummary.data.WeeklyForecasts"><span ng-hide="forecastSummary.isEditing && w.Editable">{{formatDecimal(w.Month1Commit + w.Month2Commit + w.Month3Commit, displayFormat)}}</span><span ng-show="forecastSummary.isEditing && w.Editable">{{formatDecimal(enforceNumberValidated(forecastSummary.editingModal.Month1Commit) + enforceNumberValidated(forecastSummary.editingModal.Month2Commit) + enforceNumberValidated(forecastSummary.editingModal.Month3Commit), displayFormat)}}</span></td>
                        </tr>
                        <tr>
                            <td class="noBd sticky">&nbsp;</td>
                            <td colspan="13" class="noBd">&nbsp;</td>
                        </tr>
                        <tr class="line">
                            <td class="center sticky">Upcoming Week Commit</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'UpcomingWeekCommit__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['UpcomingWeekCommit__c'].length > 0" ng-repeat="h in w.Histories['UpcomingWeekCommit__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['UpcomingWeekCommit__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
                                    <input ng-show="forecastSummary.isEditing" type="text" class="edit" ng-model="forecastSummary.editingModal.UpcomingWeekCommit" />
                                    <span ng-hide="forecastSummary.isEditing">{{formatDecimal(forecastSummary.data.UpcomingWeekCommit, displayFormat)}}</span>
                                </span>
                                <span ng-hide="w.Editable && forecastEditable && requestInProgress == 0">{{formatDecimal(w.UpcomingWeekCommit, displayFormat)}}</span>
                            </td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">Following Week Commit</td>
                            <td class="number" ng-class="{'highlight': w.Editable}" ng-repeat="w in forecastSummary.data.WeeklyForecasts">
                                <span class="fa fa-history historyBtn" ng-click="viewEditHistory(w, 'FollowingWeekCommit__c')" ng-hide="forecastSummary.isEditing">
                                    <div class="history-tooltip">
                                        <div ng-show="w.Histories['FollowingWeekCommit__c'].length > 0" ng-repeat="h in w.Histories['FollowingWeekCommit__c']">
                                            {{h.CreatedBy.Name}} on {{formatDate(h.CreatedDate)}}: {{formatDecimal(h.OldValue, displayFormat)}} --> {{formatDecimal(h.NewValue, displayFormat)}}
                                        </div>
                                        <div ng-hide="w.Histories['FollowingWeekCommit__c'].length > 0">
                                            No records to display.
                                        </div>
                                    </div>
                                </span>
                                <span ng-show="w.Editable && forecastEditable && requestInProgress == 0">
                                    <span class="fa fa-edit editBtn" ng-click="editForecast()" ng-hide="forecastSummary.isEditing" title="Edit"></span>
                                    <span class="fa fa-check saveBtn" ng-click="saveForecast()" title="Save" ng-show="forecastSummary.isEditing"></span>
                                    <span class="fa fa-times undoBtn" ng-click="cancelForecast()" title="Undo" ng-show="forecastSummary.isEditing"></span>
