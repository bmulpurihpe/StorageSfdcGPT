                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].QtrBooking+forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].QtrBooking, displayFormat)}}</td>
                            -->
                        </tr>
                        </tbody>
                    </table>
                    <br />
                    <table class="report sticky">
                        <thead>
                        <tr class="header">
                            <th class="W150 sticky">SFC Metrics</th>
                            <th class="W100">Month 1</th>
                            <th class="W100">Month 2</th>
                            <th class="W100">Month 3</th>
                            <th class="W100">Total</th>
                            <td class="noBd">&nbsp;</td>
                            <th class="W150">SFC Metrics</th>
                            <th class="W100">Current Week</th>
                            <th class="W100">Following Week</th>
                            <th class="W100">Total</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr class="line">
                            <td class="center sticky">SFC Pipeline</td>
                            <td class="number" ng-repeat="m in forecastSummary.data.MonthlyForecasts">{{formatDecimal(m.SfcPipeline, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcPipeline, displayFormat)}}</td>
                            <td class="noBd">&nbsp;</td>
                            <td class="center">SFC Pipeline</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcPipeline, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcPipeline, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcPipeline + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcPipeline, displayFormat)}}</td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">SFC Upside</td>
                            <td class="number" ng-repeat="m in forecastSummary.data.MonthlyForecasts">{{formatDecimal(m.SfcUpside, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcUpside, displayFormat)}}</td>
                            <td class="noBd">&nbsp;</td>
                            <td class="center">SFC Upside</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcUpside, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcUpside, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcUpside + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcUpside, displayFormat)}}</td>
                        </tr>
                        <tr class="line">
                            <td class="center sticky">SFC Expected</td>
                            <td class="number" ng-repeat="m in forecastSummary.data.MonthlyForecasts">{{formatDecimal(m.SfcExpected, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcExpected, displayFormat)}}</td>
                            <td class="noBd">&nbsp;</td>
                            <td class="center">SFC Expected</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcExpected, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcExpected, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcExpected + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcExpected, displayFormat)}}</td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">SFC Won</td>
                            <td class="number" ng-repeat="m in forecastSummary.data.MonthlyForecasts">{{formatDecimal(m.SfcWon, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcWon, displayFormat)}}</td>
                            <td class="noBd">&nbsp;</td>
                            <td class="center">SFC Won</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcWon, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcWon, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcWon + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcWon, displayFormat)}}</td>
                        </tr>
                        <tr class="line2">
                            <td class="center sticky">SFC Expected+Won</td>
                            <td class="number" ng-repeat="m in forecastSummary.data.MonthlyForecasts">{{formatDecimal((m.SfcWon||0)+(m.SfcExpected||0), displayFormat)}}</td>
                            <td class="number">{{formatDecimal((forecastSummary.data.SfcWon||0)+(forecastSummary.data.SfcExpected||0), displayFormat)}}</td>
                            <td class="noBd">&nbsp;</td>
                            <td class="center">SFC Expected+Won</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcExpected + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcWon, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcExpected + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcWon, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcExpected + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcExpected + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex].SfcWon + forecastSummary.data.WeeklyForecasts[forecastSummary.data.CurrentWeekIndex+1].SfcWon, displayFormat)}}</td>    
                        </tr>
                        </tbody>
                    </table>
                    <br />
                    <table class="report sticky">
                        <thead>
                        <tr class="header">
                            <th class="W150 sticky">Sales Stage Metrics</th>
                            <th class="W100">SFC Pipeline</th>
                            <th class="W100">SFC Upside</th>
                            <th class="W100">SFC Expected</th>
                            <th class="W100">SFC Won</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-class="{'line': !($index % 2), 'line2': !!($index % 2) }" ng-repeat="entry in forecastSummary.data.SalesStageMetrics">
                            <td class="center sticky">{{entry.Stage}}</td>
                            <td class="number">{{formatDecimal(entry.SfcPipeline, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(entry.SfcUpside, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(entry.SfcExpected, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(entry.SfcWon, displayFormat)}}</td>
                        </tr>
                        <tr class="footer">
                            <td class="center sticky">Total</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcPipeline, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcUpside, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcExpected, displayFormat)}}</td>
                            <td class="number">{{formatDecimal(forecastSummary.data.SfcWon, displayFormat)}}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </apex:pageBlock>

            <!---------- Opportunity List Section ---------->
            
            <apex:pageBlock >
                <apex:facet name="header">
                    <div class="sectionTitle">
                        <span ng-class="{'fa':true, 'fa-caret-down':!$storage.oppSectionCollapsed, 'fa-caret-right':$storage.oppSectionCollapsed}" ng-click="$storage.oppSectionCollapsed = !$storage.oppSectionCollapsed">Opportunity List - {{opportunityListing.recordCount>10000 ? '10000+' : opportunityListing.recordCount}} Records - Total: {{formatDecimal(opportunityListing.totalAmount, displayFormat)}}
                        <span ng-hide="$storage.oppSectionCollapsed || !opportunityListing.data || opportunityListing.data.length == 0">- Page {{opportunityListing.pageCount==0? 0 : opportunityListing.pageIndex}} / {{opportunityListing.pageCount}}</span></span>
                    </div>
                </apex:facet>
                <div class="reportContainer" ng-hide="$storage.oppSectionCollapsed" style="display:inline">
                <div class="listCaption"> 
                    Close Date <select ng-model="$storage.oppFilter.closeDate" ng-change="$storage.oppFilter.pageIndex=1;loadOpportunityListing();">
                        <option value="This Week">This Week</option>
                        <option value="Next Week">Next Week</option>
                        <option value="This Month">This Month</option>
                        <option value="Next Month">Next Month</option>
                        <option value="This Quarter">This Quarter</option>
                        <option value="Next Quarter">Next Quarter</option>
                        <option value="This Fiscal Year">This Fiscal Year</option>
                        <option value="Next Fiscal Year">Next Fiscal Year</option>
                        <option value="All">All Time</option>
                    </select>&nbsp;

                    Status <select ng-model="$storage.oppFilter.status" ng-change="$storage.oppFilter.pageIndex=1;loadOpportunityListing();">
                        <option value="All">All</option>
                        <option value="All Open">All Open</option>
                        <option value="All Won">All Won</option>
                        <option value="All Open & Won">All Open &amp; Won</option>
                        <option value="Closed Lost">Closed Lost</option>
                        <option value="Closed No Decision">Closed No Decision</option>
                    </select>&nbsp;
                    Stages <select ng-model="$storage.oppFilter.stage" ng-change="$storage.oppFilter.pageIndex=1;loadOpportunityListing();">
                        <option value="All">All Stages</option>
                        <option value="Initial Stage Opps">Initial Stage Opps (S2-S3)</option>
                        <option value="Adv Stage Opps">Adv Stage Opps (S4-S7)</option>
                    </select>&nbsp;
                    Sales Area <select ng-model="$storage.oppFilter.salesRegion" ng-change="$storage.oppFilter.pageIndex=1;loadOpportunityListing();">
                        <option value="All">All Areas</option>
                    	<apex:repeat value="{!SalesRegions}" var="region">
                            <option value="{!region}">{!region}</option>
                    	</apex:repeat>
                    	<!--
                        <option value="NA West">NA West</option>
                        <option value="NA Central">NA Central</option>
                        <option value="NA East"> NA East </option>
                        <option value="APJ">APJ</option>
                        <option value="EMEA North">EMEA North</option>
                        <option value="EMEA South">EMEA South</option>
						-->
                    </select>&nbsp;
                    Forecast Category <select ng-model="$storage.oppFilter.forecastCategory" ng-change="$storage.oppFilter.pageIndex=1;loadOpportunityListing();">
                        <option value="All">All Categories</option>
                        <option value="Omitted">Omitted</option>
                        <option value="Pipeline">Pipeline</option>
                        <option value="Upside">Upside</option>
                        <option value="Expected">Expected</option>
                    </select>&nbsp;
                    <label for="enableOppRedFlag">Enable Red Flags</label> <input id="enableOppRedFlag" type="checkbox" ng-model="$storage.oppFilter.enableRedFlag" />
                    <label for="excludeFromBookings">Show Excluded Opportunities</label> <input id="excludeFromBookings" type="checkbox" ng-model="$storage.oppFilter.excludeFromBookings" />
                    
                    <img src="/img/loading.gif" alt="loading" ng-show="opportunityListing.isLoading" />
                    <span style="float:right" ng-show="opportunityListing.data.length > 0">
                        <a class="actionLink fa fa-angle-double-left" ng-click="turnPageOppList(opportunityListing.pageIndex-1)" ng-show="opportunityListing.hasPrevious"> Previous Page</a>
                        <select ng-model="opportunityListing.pageIndex" ng-options="p as p for p in opportunityListing.pagers" ng-show="opportunityListing.pageCount>1" ng-change="turnPageOppList(opportunityListing.pageIndex)"></select>
                        <a class="actionLink" ng-click="turnPageOppList(opportunityListing.pageIndex+1)" ng-show="opportunityListing.hasNext">Next Page <span class="fa fa-angle-double-right"></span></a>
                    </span>
                </div>

                <div ng-hide="opportunityListing.data.length > 0">No opportunities to display.</div>
                <table class="report borderReport" style="width: 100%" ng-show="opportunityListing.data.length > 0">
                    <thead>
                        <tr class="header">
                            <th><a class="actionLink" ng-click="sortOppList('Name')">Opportunity Name</a> <span ng-show="$storage.oppFilter.sortField=='Name'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                        	<th><a class="actionLink" ng-click="sortOppList('Owner.Name')">Owner</a> <span ng-show="$storage.oppFilter.sortField=='Owner.Name'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Account.Name')">Account</a> <span ng-show="$storage.oppFilter.sortField=='Account.Name'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th>
                        		<span class="fa fa-group" style="margin-left:2px;margin-right:10px;"></span>
                        		<a class="actionLink" ng-click="sortOppList('Amount')">Split Amount</a> <span ng-show="$storage.oppFilter.sortField=='Amount'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span>
                        	</th>
                            <th>
                        		<a class="actionLink" ng-click="sortOppList('Amount')">Amount</a> <span ng-show="$storage.oppFilter.sortField=='Amount'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span>
                        	</th>
                            <th><a class="actionLink" ng-click="sortOppList('StageName')">Stage</a> <span ng-show="$storage.oppFilter.sortField=='StageName'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Probability')">Prob (%)</a> <span ng-show="$storage.oppFilter.sortField=='Probability'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('CloseDate')">Close Date</a> <span ng-show="$storage.oppFilter.sortField=='CloseDate'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Sales_Forecast_Category__c')">Forecast Category</a> <span ng-show="$storage.oppFilter.sortField=='Sales_Forecast_Category__c'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Type')">Type</a> <span ng-show="$storage.oppFilter.sortField=='Type'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Exclude_from_Bookings__c')">Include SoD Opportunities</a> <span ng-show="$storage.oppFilter.sortField=='Exclude_from_Bookings__c'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Opportunity_Deal_Type__c')">Opportunity Platform Type</a> <span ng-show="$storage.oppFilter.sortField=='Opportunity_Deal_Type__c'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('Reseller_Account__r.Name')">Reseller</a> <span ng-show="$storage.oppFilter.sortField=='Reseller_Account__r.Name'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                            <th><a class="actionLink" ng-click="sortOppList('NextStep')">Next Step</a> <span ng-show="$storage.oppFilter.sortField=='NextStep'" ng-class="{'fa':true, 'fa-arrow-circle-down':!$storage.oppFilter.isAscendingOrder, 'fa-arrow-circle-up':$storage.oppFilter.isAscendingOrder}"></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-class="{'line': !($index % 2), 'line2': !!($index % 2), 'highlight1': $storage.oppFilter.enableRedFlag && opportunity.HighlightLevel == 1, 'highlight2': $storage.oppFilter.enableRedFlag && opportunity.HighlightLevel == 2, 'highlight3': $storage.oppFilter.enableRedFlag && opportunity.HighlightLevel == 3, 'highlight4': $storage.oppFilter.excludeFromBookings && opportunity.ExcludeFromBookings }" ng-repeat="opportunity in opportunityListing.data | filter: ($storage.oppFilter.excludeFromBookings && opportunity.ExcludeFromBookings)">
                            <td>
                                <a href="/{{opportunity.OppId}}" target="_blank">{{unescape(opportunity.OppName)}}</a>
                            </td>
                            <td><a href="/{{opportunity.OwnerId}}" target="_blank">{{opportunity.OwnerName}}</a></td>
                            <td><a href="/{{opportunity.AccountId}}" target="_blank">{{unescape(opportunity.AccountName)}}</a></td>
                            <td class="number">
                                <span ng-if="opportunity.oppSplits.length > 0" class="fa fa-group" style="cursor:pointer;margin-left: 2px; margin-right: 10px; float: left;" data-html="true" data-container=".tooltipContainer" data-toggle="popover" data-placement="right" data-content="{{showSplitDetails(opportunity.oppSplits)}}" ></span><!--.tooltipContainer-->
                                {{formatDecimal(opportunity.SplitAmount, displayFormat)}}
                            </td>
                            <td class="number">
								{{formatDecimal(opportunity.Amount, displayFormat)}}
                            </td>
                            <td class="center">{{unescape(opportunity.Stage)}}</td>
                            <td class="number">{{formatPercentage(opportunity.Probability)}}</td>
                            <td class="center">{{opportunity.CloseDate}}</td>
                            <td class="center">{{unescape(opportunity.ForecastCategory)}}</td>
                            <td class="center">{{unescape(opportunity.Type)}}</td>
                            <td class="center">{{opportunity.ExcludeFromBookings}}</td>
                            <td class="center">{{unescape(opportunity.DealType)}}</td>
                            <td><a href="/{{opportunity.ResellerId}}" target="_blank">{{unescape(opportunity.ResellerName)}}</a></td>
                            <td style="max-width: 300px;overflow: hidden;white-space: nowrap;text-overflow: ellipsis;" title="{{unescape(opportunity.NextStep)}}">{{unescape(opportunity.NextStep)}}
                            	<span ng-if="$last" ng-init="init('.tooltipContainer')"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="listCaption" style="text-align: right;">
                    <span>Rows per page: 
                        <select ng-model="$storage.oppFilter.pageSize" ng-change="$storage.oppFilter.pageIndex=1;loadOpportunityListing();">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="75">75</option>
                            <option value="100">100</option>
                        </select>
                    </span>
                </div>
                </div>
            </apex:pageBlock>
            <div class="tooltipContainer bootstrap-iso"></div>
        </div>
    </apex:form>
</apex:page>