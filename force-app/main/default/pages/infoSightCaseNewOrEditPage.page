    <apex:stylesheet value="{!URLFOR($Resource.bootstrapiso, 'bootstrap-iso/bootstrap-iso.css')}"/>
    <script>
    $('#search').on('keydown', function(e){
        if(e.keyCode == 32 && $(this).val().indexOf('  ') >= 0){
            return false;
        }
    });
    </script>
    <script>
    
    $(function(){
        $.widget( "custom.catcomplete", $.ui.autocomplete, {
            _create: function() {
                this._super();
                this.widget().menu( "option", "items", "> :not(.ui-autocomplete-category)" );
            },
            _renderItem: function (ul, item) {
                return $("<li>")
                .attr("data-value",item.subtecharea)
                .append(item.subtecharea)
                .appendTo(ul);
            },
            _renderMenu: function( ul, items ) {
                var that = this,
                    currentTechArea = "";
                $.each( items, function( index, item ) {
                    var li;
                    if ( item.techarea != currentTechArea ) {
                        ul.append( "<li class='ui-autocomplete-category'>" + item.techarea + "</li>" );
                        currentTechArea = item.techarea;
                    }
                    li = that._renderItemData( ul, item );
                    if ( item.techarea ) {
                        li.attr( "aria-label", item.techarea + " : " + item.subtecharea );
                    }
                });
            }
        });
        $.ajax({
            'async': true,
            'global': false,
            //'url': "{!URLFOR($Resource.techareasubtecharea, '/techandsubtechareacombinations.json')}",
            'dataType': "text",
            
            'success': function (data) {
                
                $("#search").catcomplete({
                    delay: 0,
                    source: {!fieldDependencies},
                    select: function (event, ui) {
                        
                        $('#search').val(ui.item.techarea + " : " + ui.item.subtecharea);
                        
                        var techsubtech= $('#search').val();
                        if(techsubtech != null && techsubtech != ''){
                            var splitting = techsubtech.split(' : ');
                            takeTSAValue = splitting[1];
                            var controllingField = document.getElementById('page:form:block:blocksection:techArea');
                            var isFound = false;
                            for(i=0; i<controllingField.options.length;i++){
                                console.log(controllingField.options[i].value);
                                if(controllingField.options[i].value == splitting[0]){
                                    isFound = true;
                                }
                            }
                            if(isFound == false){
                                controllingField.options.add( new Option(splitting[0],splitting[0]) );
                            }
                            
                            controllingField.value = splitting[0];
                            controllingField.onchange();
                            /*if(controllingField.value == '' || controllingField.value == null){
                                alert('Selected Technical Area value is not available for the current record type');
                            }*/
                            var isFoundTSA = false;
                            for(i=0; i<document.getElementById('page:form:block:blocksection:subTechArea').options.length;i++){
                                console.log(document.getElementById('page:form:block:blocksection:subTechArea').options[i].value);
                                if(document.getElementById('page:form:block:blocksection:subTechArea').options[i].value == splitting[1]){
                                    isFoundTSA = true;
                                }
                            }
                            if(isFoundTSA == false){
                                document.getElementById('page:form:block:blocksection:subTechArea').options.add( new Option(splitting[1],splitting[1]) );
                            }
                            document.getElementById('page:form:block:blocksection:subTechArea').value = splitting[1];
                            if(document.getElementById('page:form:block:blocksection:subTechArea').value == 'Damaged in shipping' || document.getElementById('page:form:block:blocksection:subTechArea').value =='Damaged at customer site not shipping related'){
                                document.getElementById('page:form:block:blocksection:outputPanelToDisplayDamageSymptoms').style.display = 'block';
                            }
                            else{
                                document.getElementById('page:form:block:blocksection:outputPanelToDisplayDamageSymptoms').style.display = 'none';
                            }
                            /*if(document.getElementById('page:form:block:blocksection:subTechArea').value == '' || document.getElementById('page:form:block:blocksection:subTechArea').value == null){
                                alert('Selected Sub-Technical Area value is not available for the current record type');
                            }*/
                        }
                        return false;
                    },
                    response: function(event, ui) {
                        if (!ui.content.length) {
                            $('#noResults').show();
                            $("#message").text("No Suggestions Found");
                        } else {
                            $('#noResults').hide();
                            $("#message").empty();
                        }
                    }
                })
            }
        });
    })
    
    function bindValueFromSearch(){
        if(takeTSAValue != ''){
            document.getElementById('page:form:block:blocksection:subTechArea').value = takeTSAValue;
            if(document.getElementById('page:form:block:blocksection:subTechArea').value == ''){
                document.getElementById('page:form:block:blocksection:subTechArea').value = '--None--';
            }
        }
        if(takeTSAValue == null){
            document.getElementById('page:form:block:blocksection:subTechArea').value = '--None--';
        }
    }
    </script>
    <script>
    function techAreaOnchange(){
        if(document.getElementById('page:form:block:blocksection:techArea').value != null && document.getElementById('page:form:block:blocksection:subTechArea').value != null){
            if($('#search').val() != null){
                $('#search').val('');
            }
        }
    }
    function checkAuoComplete(){
        if($('#search').val() != null){
            var splitting = $('#search').val().split(' : ');
            document.getElementById('page:form:block:blocksection:subTechArea').value = splitting[1];
        }  
    }
    //var getTechnicalArea;
    function dispatcherToCallActionFunction(){
        dispatchForTSALoad();
        if(document.getElementById('page:form:block:blocksection:techArea').value != null && document.getElementById('page:form:block:blocksection:subTechArea').value != null){
            if($('#search').val() != null){
                $('#search').val('');
            }
        }
    }
