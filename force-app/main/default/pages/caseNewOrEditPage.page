    <script>
    $('#search').on('keydown', function(e){
        if(e.keyCode == 32 && $(this).val().indexOf('  ') >= 0){
            return false;
        }
    });
    </script>
    <script>
    
    $(function(){
        $.widget( "custom.catcomplete", $.ui.autocomplete, {
            _create: function() {
                this._super();
                this.widget().menu( "option", "items", "> :not(.ui-autocomplete-category)" );
            },
            _renderItem: function (ul, item) {
                return $("<li>")
                .attr("data-value",item.subtecharea)
                .append(item.subtecharea)
                .appendTo(ul);
            },
            _renderMenu: function( ul, items ) {
                var that = this,
                    currentTechArea = "";
                $.each( items, function( index, item ) {
                    var li;
                    if ( item.techarea != currentTechArea ) {
                        ul.append( "<li class='ui-autocomplete-category'>" + item.techarea + "</li>" );
                        currentTechArea = item.techarea;
                    }
                    li = that._renderItemData( ul, item );
                    if ( item.techarea ) {
                        li.attr( "aria-label", item.techarea + " : " + item.subtecharea );
                    }
                });
            }
        });
        $.ajax({
            'async': true,
            'global': false,
            //'url': "{!URLFOR($Resource.techareasubtecharea, '/techandsubtechareacombinations.json')}",
            'dataType': "text",
            
            'success': function (data) {
                
                $("#search").catcomplete({
                    delay: 0,
                    source: {!fieldDependencies},
                    select: function (event, ui) {
                       $('#search').val(ui.item.techarea + " : " + ui.item.subtecharea);
                       var techsubtech= $('#search').val();
                       if(techsubtech != null && techsubtech != ''){
                            var splitting = techsubtech.split(' : ');
                            takeTSAValue = splitting[1];
                           
                            var controllingField = document.getElementById('page:form:block:blocksection:pbsectionItemTechArea:techArea');
                            console.log('controllingField ## ' + controllingField);
                            var isFound = false;
                            for(i=0; i<controllingField.options.length;i++){
                                console.log(controllingField.options[i].value);
                                if(controllingField.options[i].value == splitting[0]){
                                    isFound = true;
                                }
                            }
                            if(isFound == false){
                                controllingField.options.add( new Option(splitting[0],splitting[0]) );
                            }
                            
                            controllingField.value = splitting[0];
                            controllingField.onchange();
                            /*if(controllingField.value == '' || controllingField.value == null){
                                alert('Selected Technical Area value is not available for the current record type');
                            }*/
                            var isFoundTSA = false;
                            for(i=0; i<document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').options.length;i++){
                                console.log(document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').options[i].value);
                                if(document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').options[i].value == splitting[1]){
                                    isFoundTSA = true;
                                }
                            }
                            if(isFoundTSA == false){
                                document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').options.add( new Option(splitting[1],splitting[1]) );
                            }
                            document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value = splitting[1];
                            if(document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value == 'Damaged in shipping' || document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value =='Damaged at customer site not shipping related'){
                                document.getElementById('page:form:block:blocksection:outputPanelToDisplayDamageSymptoms').style.display = 'block';
                            }
                            else{
                                document.getElementById('page:form:block:blocksection:outputPanelToDisplayDamageSymptoms').style.display = 'none';
                            }
                            /*if(document.getElementById('page:form:block:blocksection:subTechArea').value == '' || document.getElementById('page:form:block:blocksection:subTechArea').value == null){
                                alert('Selected Sub-Technical Area value is not available for the current record type');
                            }*/
                        }
                       return false;
                    },
                    response: function(event, ui) {
                        if (!ui.content.length) {
                            $('#noResults').show();
                            $("#message").text("No Suggestions Found");
                        } else {
                            $('#noResults').hide();
                            $("#message").empty();
                        }
                    }
                })
            }
        });
    })
    
    function bindValueFromSearch(){
         if(takeTSAValue != ''){
            document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value = takeTSAValue;
            if(document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value == ''){
                document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value = '--None--';
            }
        }
        if(takeTSAValue == null){
            document.getElementById('page:form:block:blocksection:pbsectionItemsubTechArea:subTechArea').value = '--None--';
        }
    }
    </script>
