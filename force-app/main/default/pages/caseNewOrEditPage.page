                <script>
                var previousOnload = window.onload;
                
                //Added by Ntelkar for TS-9491
                function inputPriority(inpVal){
                    console.log('The input is - '+inpVal);
                    if(inpVal =='P1')
                    getSeverity("Critical");
                    if(inpVal =='P2')
                    getSeverity("Critical - Degraded");
                    if(inpVal =='P3')
                    getSeverity("Non-Critical");
                    if(inpVal =='P4')
                    getSeverity("Low Priority");
                }
                    
                    //Added by Ntelkar for TS-9491
                    function inputSeverity(inpVal){
                    console.log('The input is - '+inpVal);
                    if(inpVal =='Critical')
                    getPriority("P1");
                    if(inpVal =='Critical - Degraded')
                    getPriority("P2");
                    if(inpVal =='Non-Critical')
                    getPriority("P3");
                    if(inpVal =='Low Priority')
                    getPriority("P4");
                }
                    
                    function inputIsStorageIssue(inpVal){
                    if(inpVal =='Yes')
                    getIsNimbleStorageDefect("Yes");
                    if(inpVal =='No')
                    getIsNimbleStorageDefect("No");
                    
                }
                    //Added by Exafort for SFDC-307
                    function onAsseteNumberChange(){
                    let assetId = document.getElementById('page:form:block:section:asstId_lkid').value;
                    console.log('Selected Asset ID:', assetId);
                    AssetNumberParam(assetId);
                    
                }
                    //	Added by Exafort for SFDC-936
                    function updateTimer() {
                    var statusElem = document.querySelector('[id$="caseStatus"]');
                    var status = statusElem.value;
                    var x3StrikeElem = document.querySelector('[id$="x3Strike"]'); // Added by Exafort for SFDC-1518
                    var x3Strike = x3StrikeElem ? x3StrikeElem.checked : false; // Added by Exafort for SFDC-1518
                    
                    console.log('x3 Strike Checked:', x3Strike);
                    updateTimerFromApex(status,null,x3Strike); // Added by Exafort for SFDC-1518
                    
                }
                                       
                                       function updateSubStatusTimer() {
                                           var statusElem = document.querySelector('[id$="caseStatus"]');
                                           var status = statusElem.value;
                                           var subStatusElem = document.querySelector('[id$="caseSubStatus"]');
                                           var subStatus = subStatusElem.value;
                                           var x3StrikeElem = document.querySelector('[id$="x3Strike"]'); // Added by Exafort for SFDC-1518
                                           var x3Strike = x3StrikeElem ? x3StrikeElem.checked : false; // Added by Exafort for SFDC-1518
                                           
                                           console.log('x3 Strike Checked:', x3Strike);
                                           updateTimerFromApex(status, subStatus,x3Strike); // Added by Exafort for SFDC-1518
                                       }
                                       // Added by Exafort for SFDC-1518
                                       function updateStrike3Timer() {
                    var statusElem = document.querySelector('[id$="caseStatus"]');
                    var status = statusElem.value;
                    var subStatusElem = document.querySelector('[id$="caseSubStatus"]');
                    var subStatus = subStatusElem.value;
                    var x3StrikeElem = document.querySelector('[id$="x3Strike"]');
                    var x3Strike = x3StrikeElem ? x3StrikeElem.checked : false;
                    
                    console.log('x3 Strike Checked:', x3Strike);
                    updateTimerFromApex(status, subStatus,x3Strike);
                    
                }
    // Ended by Exafort for SFDC-1518
    function updateTimerUI() {
        var timerValue = document.querySelector('[id$="timerValueHolder"]').innerText;
        console.log("timer Value:", timerValue.value);
        setTimerValue(timerValue);
    }
    
    function setTimerValue(val) {
        var timerField = document.querySelector('[id$="timerExpiryDateVar"]');
        if (timerField) {
            timerField.value = val;
            console.log('timer field',timerField.value); 
        }
        
        var overrideField = document.querySelector('input[id$="overrideField"]');
        var expiryText = document.querySelector('[id$="timerExpiryDateVar"]');
        var status = document.querySelector('[id$="caseStatus"]');
        var statusVal = status.value || status.innerText;
        console.log("Override Field:", overrideField.value);
        console.log("expiryText Field:", expiryText.value);
        console.log("expiryText Field:", expiryText.innerText);
        console.log("status Field:", status.innerText);
        console.log("status Val:", statusVal);
        if (overrideField) {
            if (expiryText.innerText.trim() !== '') {
                console.log('Override Field should be editable');
                overrideField.disabled = false;
            } else if (statusVal === 'On Hold' || statusVal === 'Remote Session Scheduled') {
                // Empty expiry + allowed status → editable
                overrideField.disabled = false;
                console.log("Override Field should be editable (allowed status with empty expiry)");
            }else {
                console.log('Override Field should be read-only');
                overrideField.disabled = true;
            }
        }
        
        
    }
    
    window.onload = function () {
        // First block of onload function
        //to remove Close from the Case status 
        if (previousOnload) { 
            previousOnload();
        } 
        
        var condition = true; // condition
        if(condition) {            
            var url = window.location.href;
            var acctId = 'acctId';
            var contId = 'contId';
            var asstId = 'asstId';
            
            if(url.indexOf(acctId + '=') != -1){
                document.getElementById('page:form:block:section:Acc:acctId').value =  "{!$CurrentPage.parameters.acctId}";
            }
            if(url.indexOf(contId + '=') != -1){
                document.getElementById('page:form:block:section:contId').value =  "{!$CurrentPage.parameters.contId}";
            }
            if(url.indexOf(asstId + '=') != -1){
                document.getElementById('page:form:block:section:asstId').value =  "{!$CurrentPage.parameters.asstId}";
            }
            //document.getElementById('page:form:block:section:duplicateCaseId').blur(); // Exafort SFDC-1152 - removed from the layout 
            document.getElementById('page:form:block:section:Acc:acctId').blur();

         if('{!Case.Status}' != 'Closed'){
             var options = document.getElementById('page:form:block:section:caseStatus');
                 for(var i=0; i<options.length; i++) {
                     if(options[i].innerHTML == 'Closed' || options[i].innerHTML == 'Closed(Duplicate)') {
                     options.removeChild(options[i]);
                     i--; // options have now less element, then decrease i
                 }
         
     		}
     	}
     }
        
        //Added for Timer related changes         
        var expiryVal = "{!IF(ISBLANK(Case.Timer_Expiry_Date__c), '', 'notBlank')}";
        var overrideInput = document.querySelector('input[id$="overrideField"]');
        var status = document.querySelector('[id$="caseStatus"]');
        var statusVal = status.value || status.innerText;
        if (overrideInput) {
            if (expiryVal === '') {
                if (statusVal === 'Remote Session Scheduled' || statusVal === 'On Hold') {
                    overrideInput.disabled = false;
                    console.log("On Load: Override Field enabled (Status is Remote Session Scheduled or On Hold)");
                } else {
                    overrideInput.disabled = true;
                    console.log("On Load: Override Field disabled (Timer Expiry is blank)");
                }
            } else {
                overrideInput.disabled = false;
                console.log("On Load: Override Field enabled (Timer Expiry is not blank)");
            }
        }
    };
    //  End of SFDC-936
    // Exafort SFDC-1152 - Added to show spinner on Save button click.
    function showSpinner() {
        document.getElementById('spinnerWrapper').style.display = 'block';
    }
    
    </script>
