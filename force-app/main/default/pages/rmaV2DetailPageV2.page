    <script>
    var previousOnload = window.onload;
    window.onload = function() 
    { 
        if (previousOnload) { 
            previousOnload();
        } 
        if(('{!RMAv2__c.rmaPartNumber__c}' == 'SR-CONT-CS235' ||
            '{!RMAv2__c.rmaPartNumber__c}' == 'SR-CONT-CS300' ||
            '{!RMAv2__c.rmaPartNumber__c}' == 'SR-CONT-CS500' ||
            '{!RMAv2__c.rmaPartNumber__c}' == 'SR-CONT-CS700') && (
            '{!RMAv2__c.rmaCaseNimbleVersion__c}' == '2.3.4.0' ||
            '{!RMAv2__c.rmaCaseNimbleVersion__c}' == '2.3.6.0' ||
            '{!RMAv2__c.rmaCaseNimbleVersion__c}' == '2.3.7.0' ||
            '{!RMAv2__c.rmaCaseNimbleVersion__c}' == '2.3.8.0')) {
            
            alert('RMA Number = {!RMAv2__c.Name}\n' +
                  'Part = {!RMAv2__c.rmaPartNumber__c}\n' +
                  'Nimble OS Version = {!RMAv2__c.rmaCaseNimbleVersion__c}\n\n' +
                  '*** WARNING *** WARNING *** WARNING ***\n\n' +
                  'This combination of Controller Part and Nimble OS has known issue\n' +
                  'Please inform the customer not to halt the controller to do the replacement but to hot remove it.');
        }
        
    }
    </script>
    <script>
    function disableSaveRMAButton(){
        document.getElementById('Page:myform:cancelRMAButton').disabled = true;
        return false;
    }
    function enableButton(){
        if(document.getElementById('Page:myform:rmaRMACancellationReason').value == null || document.getElementById('Page:myform:rmaRMACancellationReason').value == ''){
            document.getElementById('Page:myform:cancelRMAButton').disabled = true;
        }
        else{
            document.getElementById('Page:myform:cancelRMAButton').disabled = false;
        }
    }
    function checkDeliveryPreference(){
        var result=false;
        
        if('{!RMAv2__c.rmaAssetSameDayPartDeliveryPreference__c}' == 'SAME-DAY-20: Deliver only during business hours (9am to 5pm asset time)'){
            
            result=confirm('*** WARNING *** WARNING *** WARNING ***\n\nDelivery Preference is - {!RMAv2__c.rmaAssetSameDayPartDeliveryPreference__c}\n\n***Please check asset current local time*** '+'\n\n\nClick \"OK\" Button to Submit the RMA  or  Click \"Cancel\" to not proceed');
        }
        else if('{!RMAv2__c.rmaAssetSameDayPartDeliveryPreference__c}' == 'SAME-DAY-30: Always call customer first'){
            
            result=confirm('*** WARNING *** WARNING *** WARNING ***\n\nDelivery Preference is - {!RMAv2__c.rmaAssetSameDayPartDeliveryPreference__c}\n\n***Has the customer been called?***'+'\n\n\nClick \"OK\" Button to Submit the RMA  or Click \"Cancel\" to not proceed');
        }
            else{
                
                result=true;
            }
        
        if(result==true){
            console.log('insideSubmitRMA');
            submitRMA();
        }
    }
    //Added By Exafort for TS-10592
    /*
		This Logic is to hide the value 'System/part return' in the Order Data for all the Profiles except 'NS-BusinessAdmin Support' on detail page.
         If the NSBusinessAdminSupportProfile is Null then 'System/part return' will not be hiden.
    */
    document.addEventListener('DOMContentLoaded', function() {          
        var currentUserProfileId = '{!$User.ProfileId}';
        var NSBusinessAdminSupportProfile = '{!NSBusinessAdminSupportProfileId}'; 
        var dataKeyValues = document.getElementById('Page:myform:pageBlockId:DataKeyValueSection:DataKeyValueSectionItem:DataKeyValueId');
        var content = dataKeyValues.innerHTML;
        if ( NSBusinessAdminSupportProfile != '' && NSBusinessAdminSupportProfile != currentUserProfileId ) {
            content = content.replace('<br>Order Type: System/part return', '');
            dataKeyValues.innerHTML = content;
        }
    });
    //End of TS-10592
    </script>
    
