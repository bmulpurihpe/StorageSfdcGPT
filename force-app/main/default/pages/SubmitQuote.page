<apex:page standardController="SBQQ__Quote__c" extensions="QuoteExtController" docType="html-5.0" sidebar="false" showHeader="false">

    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.4/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap3-dialog/1.34.7/css/bootstrap-dialog.min.css" rel="stylesheet"/>
    <!--jQuery-->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>    
    <!--bootstrap-->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.4/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap3-dialog/1.34.7/js/bootstrap-dialog.min.js"></script>

  <apex:pageMessages />

  <script type="text/javascript">
    //spinner
    var loadingPannel;
    loadingPannel = loadingPannel || (function () {
        var lpDialog = $("" +
            "<div class='modal' id='lpDialog' data-backdrop='static' data-keyboard='false'>" +
                "<div class='modal-dialog' >" +
                    "<div class='modal-content'>" +
                        "<div class='modal-header'><b>Submitting quote for approval...</b></div>" +
                        "<div class='modal-body'>" +
                            "<div class='progress'>" +
                                "<div class='progress-bar progress-bar-striped active' role='progressbar' aria-valuenow='100' aria-valuemin='100' aria-valuemax='100' style='width:100%'> "+
                                  "Please Wait..."+
                                "</div>"+
                              "</div>"+
                        "</div>" +
                    "</div>" +
                "</div>" +
            "</div>");
        return {
          //call the below methods to show/hide the spinner
          show: function () {
              lpDialog.modal('show');
          },
          hide: function () {
              lpDialog.modal('hide');
          },
        };
    })();   //End of Spinner


    var quoteId = "{!SBQQ__Quote__c.id}";
    var quoteStatus = "{!SBQQ__Quote__c.SBQQ__Status__c}";
    var isPartnerUser = "{!SBQQ__Quote__c.IsPartnerUser__c}";
    var approvalStatus = "{!SBQQ__Quote__c.ApprovalStatus__c}";
    var hasnopowercord = "{!SBQQ__Quote__c.hasPowerCord__c}";
    var hasOnlyNCVLines = "{!SBQQ__Quote__c.hasNCVLines__c}";
    var hasOldPricebook ="{!SBQQ__Quote__c.hasOldPricebook_OEM__c}";
    console.log('IsPartnerUser :: '+ isPartnerUser);
    console.log('Quote Status is :: '+ quoteStatus);
    
    if(hasOldPricebook == 'true'){
        
        BootstrapDialog.show({
            type : BootstrapDialog.TYPE_DANGER,
            title : 'ALERT!!!',
            message : 'All Gen5 products require OEM-AF-HF-G5 tracking SKU. Please update price book to FY20 and reconfigure the quote.',
            buttons: [{
              label: 'Return to Quote',
              action: function(){
                window.location = ('../'+quoteId);
              }
            }]
        });
    }
    else if(hasnopowercord == 'true'){
        
        BootstrapDialog.show({
            type : BootstrapDialog.TYPE_DANGER,
            title : 'ALERT!!!',
            message : 'Quote is missing Power Cords on the Controller.Please edit the configuration and add Power Cord',
            buttons: [{
              label: 'Return to Quote',
              action: function(){
                window.location = ('../'+quoteId);
              }
            }]
        });
    }
    else if(hasOnlyNCVLines == 'false'){
        
        BootstrapDialog.show({
            type : BootstrapDialog.TYPE_DANGER,
            title : 'ALERT!!!',
            message : 'Quote contains NCV lines. Please edit the Quote.',
            buttons: [{
              label: 'Return to Quote',
              action: function(){
                window.location = ('../'+quoteId);
              }
            }]
        });
    }
    else if(isPartnerUser && quoteStatus == 'Orderable') {

        console.log('Quote status is:: '+ quoteStatus);
        //window.location = ('../'+quoteId);
        BootstrapDialog.show({
            type : BootstrapDialog.TYPE_DANGER,
            title : 'ALERT!!!',
            message : 'The quote has not been accepted yet. Please scroll down to the bottom of the quote and press the Submit for approval button for Acceptance of quote.',
            buttons: [{
              label: 'Return to Quote',
              action: function(){
                window.location = ('../'+quoteId);
              }
            }]
        });
    }
    else if(approvalStatus == 'Approved'){
        
        BootstrapDialog.show({
            type : BootstrapDialog.TYPE_DANGER,
            title : 'ALERT!!!',
            message : 'This quote has already been approved.',
            buttons: [{
              label: 'Return to Quote',
              action: function(){
                window.location = ('../'+quoteId);
              }
            }]
        });
    }
    else if(approvalStatus == 'Pending'){
        console.log('Entered Pending Approval Status');
        BootstrapDialog.show({
            type : BootstrapDialog.TYPE_DANGER,
            title : 'WARNING: Quote approval in-progress',
            message : 'This quote has already been submitted for Approval.',
            buttons: [{
              label: 'Return to Quote',
              action: function(){
                window.location = ('../'+quoteId);
              }
            }]
        });
    }
    else{
        submitForApproval();
    }

    function submitForApproval() {
        console.log('Quote submitted for approval.');
        
        //display spinner
        //loadingPannel.show();

        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.QuoteExtController.onSubmit}',
            quoteId,
            function(result, event){
                if (event.status) {
                    //hide spinner
                    //loadingPannel.hide();

                    /*BootstrapDialog.show({
                        type : BootstrapDialog.TYPE_SUCCESS,
                        title : 'Success!',
                        message : 'This quote has been been submitted for Approval.',
                        buttons: [{
                          label: 'Return to Quote',
                          action: function(){
                            window.location = ('../'+quoteId);
                          }
                        }]
                    });*/
                    
                    window.location = ('../'+quoteId);
                }
                else if (event.type == 'exception') {
                    //hide spinner
                    //loadingPannel.hide();

                    //alert('Oops, something went wrong! Please contact your System Administrator for help.');
                    window.location = ('../'+quoteId);
                }
            }, 
            {escape: true}
        );
    }

  </script>

</apex:page>