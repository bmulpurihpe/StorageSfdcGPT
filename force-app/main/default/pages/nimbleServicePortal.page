                                                    <apex:inputText id="inputTextBox" size="255" maxlength="255" value="{!WrapperListValue.textValue}" rendered="{!WrapperListValue.isText}" style="width:395px;"
                                                                    disabled="{!WrapperListValue.cfieldReadOnly}"/><!--required="{!WrapperListValue.cfieldRequired}"-->
                                                    <apex:inputTextArea id="inputTextAreaBox" value="{!WrapperListValue.textAreaValue}" style="margin: 0px; height: 60px; width: 394px;" 
                                                                        disabled="{!WrapperListValue.cfieldReadOnly}"
                                                                        onkeydown="checkLimit(this,255);"  
                                                                        onkeyup="checkLimit(this,255);" 
                                                                        onchange="checkLimit(this,255);"
                                                                        rendered="{!AND(WrapperListValue.isTextArea,IF(WrapperListValue.cfieldLabel == 'Additional Info',false,true))}" /> <!--required="{!WrapperListValue.cfieldRequired}"-->
                                                    <!-- TS-6516 Exafort Guru Dev-->
                                                    <apex:outputPanel rendered="{!WrapperListValue.IsAttachment}">
                                                    <input type="file" multiple="false" id="fileinput" onchange="uploadFiles();"/>
                                                        <!--disabled="{!WrapperListValue.cfieldReadOnly}"-->
                                                    </apex:outputPanel>
                                                    <!--Added end-->

                                                </apex:outputPanel>
                                            </td>                                       
                                        </tr>
                                    </apex:repeat>
                                </table>
                                
                            </fieldset>
                            <!--Handling Field Information Section-->
                            <fieldset>
                                <legend>
                                    Handling 
                                </legend>
                                <table style="float:right;width:100%">  <!--style="float:left;width:100%"  -->
                                    <apex:repeat value="{!servicePortalWrapList}" var="WrapperListValuee" id="repeatId_2">
                                        <tr style="width:50%;{!IF(WrapperListValuee.cfieldLabel == 'Additional Info' || WrapperListValuee.cfieldLabel == 'Is this under duress ?','','display:none')}">
                                            <td style="width:50%;float: right;"><!--style="width:50%;float:right;"-->
                                                <apex:outputLabel value="{!WrapperListValuee.cfieldLabel}" 
                                                                  rendered="{!IF(WrapperListValuee.cfieldLabel == 'Additional Info' || WrapperListValuee.cfieldLabel == 'Is this under duress ?',true,false)}"/>&nbsp;
                                                <apex:image value="{!$Resource.helpTextImage}" styleClass="helpIcon" title="{!WrapperListValuee.cfieldDesc}" 
                                                            rendered="{!IF(WrapperListValuee.cfieldLabel == 'Additional Info' || WrapperListValuee.cfieldLabel == 'Is this under duress ?',true,false)}"/>
                                            </td>
                                            <td style="width:50%"> <!--style="float:left;width:50%"---->
                                                <apex:outputPanel styleClass="{!IF(WrapperListValuee.cfieldRequired == true, 'requiredInput','none')}" layout="block"> 
                                                    <apex:outputPanel styleClass="{!IF(WrapperListValuee.cfieldRequired == true,'requiredBlock','none')}" layout="block"/> <!--required="{!WrapperListValuee.cfieldRequired}"-->
                                                    <apex:inputCheckbox value="{!WrapperListValuee.isCheckboxSelected}" id="BodyCheckboxId_2"
                                                                        styleClass="BodyCheckbox" disabled="{!WrapperListValuee.cfieldReadOnly}" required="{!WrapperListValuee.cfieldRequired}"
                                                                        rendered="{!AND(WrapperListValuee.isCheckbox,IF(WrapperListValuee.cfieldLabel == 'Is this under duress ?',true,false))}">
                                                        
                                                    </apex:inputCheckbox>
                                                    <apex:selectList value="{!WrapperListValuee.picklistVal}" multiselect="{!WrapperListValuee.isMultiSelectPicklist}" size="1" id="picklistvalues"
                                                                     styleClass="BodyPicklistValues" disabled="{!WrapperListValuee.cfieldReadOnly}" style="width:400px;"
                                                                     rendered="{!AND(WrapperListValuee.isPicklist,IF(WrapperListValuee.cfieldLabel != 'Additional Info' || WrapperListValuee.cfieldLabel != 'Is this under duress ?',false,true))}">
                                                        <apex:selectOptions value="{!WrapperListValuee.picklistValues}" />
                                                    </apex:selectList>
                                                    <!--required="{!WrapperListValuee.cfieldRequired}"-->
                                                    <apex:inputText value="{!WrapperListValuee.textValue}"  id="inputTextBox_2" style="width:395px;"
                                                                    disabled="{!WrapperListValuee.cfieldReadOnly}" required="{!WrapperListValuee.cfieldRequired}"
                                                                    rendered="{!AND(WrapperListValuee.isText,IF(WrapperListValuee.cfieldLabel != 'Additional Info' || WrapperListValuee.cfieldLabel != 'Is this under duress ?',false,true))}"/>
                                                    <apex:inputTextArea value="{!WrapperListValuee.textAreaValue}" style="margin: 0px; height: 60px; width: 394px;"
                                                                        id="inputTextAreaBox_2" required="{!WrapperListValuee.cfieldRequired}" disabled="{!WrapperListValuee.cfieldReadOnly}"
                                                                        onkeydown="checkLimit(this,255);"  
                                                                        onkeyup="checkLimit(this,255);" 
                                                                        onchange="checkLimit(this,255);"
                                                                        rendered="{!AND(WrapperListValuee.isTextArea,IF(WrapperListValuee.cfieldLabel == 'Additional Info',true,false))}" />
                                                    
                                                    
                                                </apex:outputPanel>
                                            </td>                                       
                                        </tr>
                                    </apex:repeat>
                                </table>
                                
                            </fieldset>
                            
                        </apex:outputPanel>
                        
                        <!--Save Save& New Button Section-->
                        <apex:pageBlockButtons id="PBB" >
                            <apex:CommandButton onclick="disableSaveButtons()" value="Save" action="{!insertCaseDocketFieldData1}" status="SaveStatusId" reRender="Sectiontohide,Sectiontohide2" /> 
                            
                            <apex:CommandButton onclick="disableSaveButtons()" value="Save & New" action="{!insertCaseDocketFieldData2}" status="SaveStatusId" reRender="Sectiontohide,Sectiontohide2"/>
                            
                        </apex:pageBlockButtons>
                        
                    </apex:pageBlock>
                    <!-- To display three vertical panels section My recent cases,popular items and related cases -->
                    <!-- Added by Guru Dev(Exafort) for TS-8933 on 16/Feb/22-->
                    <table style="border-collapse: collapse; width: 100%;" border="0"  cellpadding="5">
                        <tbody>
                            <tr>
                                <td style="width: 33.3333%;"><br/>
                                    <!--page block section to display My recent cases-->
                                    <apex:pageBlock rendered="{!IF(selectedRequest != '','false','true')}"><br/>
                                        <font size="+0.5">
                                            <strong>My Recent Cases</strong><br/><br/>
                                        </font>
                                        <apex:outputPanel rendered="{!IF(MyCaseList.size > 0,'TRUE','FALSE')}">
                                            <apex:pageBlockTable value="{!MyCaseList}" var="MyCases">
                                                <apex:column headerValue="CaseNumber">
                                                    <apex:outputLink value="/{!MyCases.Id}" target="_blank">
                                                        {!MyCases.CaseNumber}
                                                    </apex:outputLink>
                                                </apex:column>
                                                <apex:column headerValue="Subject">
                                                    <apex:outputLink value="/{!MyCases.Id}" target="_blank">
                                                        {!MyCases.Subject}
                                                    </apex:outputLink>
                                                </apex:column>
                                            </apex:pageBlockTable>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!IF(MyCaseList.size = 0,'TRUE','FALSE')}">
                                            &nbsp; <B>No Recent Cases</B>
                                        </apex:outputPanel>
                                    </apex:pageBlock>
                                </td>
                                <td style="width: 33.3333%;">&nbsp;
                                    <!--page block section to display popular Requests-->
                                    <apex:pageBlock rendered="{!IF(selectedRequest != '','false','true')}"><br/>
                                        <font size="+0.5">
                                            <strong>Popular Requests</strong><br/><br/>
                                        </font>
                                        <apex:outputPanel rendered="{!IF(PopularItemList.size > 0,'TRUE','FALSE')}">
                                            <apex:variable value="{!0}" var="rowNum"/>
                                            <apex:pageBlockTable value="{!PopularItemList}" var="PopItmlst" >
                                                <apex:column headerValue="Case Docket" onclick="ChangeUrlOnPicklistChangeCombo('{!rowNum}')">
                                                    <apex:variable var="rowNum" value="{!rowNum + 1}"/>
                                                    <u>
                                                        {!PopItmlst['DocketLabel']}
                                                    </u>
                                                </apex:column>
                                            </apex:pageBlockTable>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!IF(PopularItemList.size = 0,'TRUE','FALSE')}">
                                            &nbsp; <B>No Dockets Found</B>
                                        </apex:outputPanel>
                                    </apex:pageBlock>
                                </td>
                                <td style="width: 33.3333%;">&nbsp;
                                    <!--page block section to display related cases-->
                                    <apex:pageBlock rendered="{!IF(selectedRequest != '','false','true')}"><br/>
                                        <font size="+0.5">
                                            <strong>Related Cases</strong><br/><br/>
                                        </font>
                                        <apex:outputPanel rendered="{!IF(casesForRecordIdinUrlcase.size > 0,'TRUE','FALSE')}">
                                            <apex:pageBlockTable value="{!casesForRecordIdinUrlcase}" var="CRec">
                                                <apex:column headerValue="Case Number">
                                                    <apex:outputLink value="/{!CRec.Id}"  target="_blank">
                                                        {!CRec.CaseNumber} 
                                                    </apex:outputLink>
                                                </apex:column>
                                                <apex:column headerValue="Subject">
                                                    <apex:outputLink value="/{!CRec.Id}"  target="_blank">
                                                        {!CRec.Subject}
                                                    </apex:outputLink>
                                                </apex:column>
                                                <apex:column headerValue="Underlying Object">
                                                    <apex:outputLink value="/{!CRec.CaseDocket__c}"  target="_blank">
                                                        {!CRec.CaseDocket__r.cdUnderlyingObject__c}
                                                    </apex:outputLink>
                                                </apex:column>
                                            </apex:pageBlockTable> 
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!IF(casesForRecordIdinUrlcase.size = 0,'TRUE','FALSE')}">
                                            &nbsp; <B>No Related Cases Found</B>
                                        </apex:outputPanel>
                                    </apex:pageBlock></td>
                            </tr>
                        </tbody>
                    </table>
                    <!--Added End-->
                </apex:outputPanel>
            </apex:form>
        </body>
    </html>
</apex:page>