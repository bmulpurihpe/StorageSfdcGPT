            function ChangeUrlOnPicklistChangeCombo(rowNumval){  
                sforce.connection.sessionId = '{!$Api.Session_ID}';
                if(rowNumval >= 0){                
                    var requestValue = document.getElementById("Thepage:TheformTwo:j_id234:j_id238:"+rowNumval+":j_id239").innerText;
                    
                }
                else if (rowNumval == undefined) {
                    var requestValue = document.getElementById("Thepage:Theform:pBS:pBSOne:RequestCombo").value;
                }
                console.log('### requestValue ===>'+requestValue);
                soql = "select Id,Name,cdLabel__c From Case_Docket__c where cdLabel__c='"+requestValue+"'";
                console.log('### soql ===>'+soql);
                result = sforce.connection.query(soql);
                console.log('### result ===>'+result);
                console.log('### result size===>'+result.size);
                if(result.size == 1){
                    records = result.records["Name"];
                    console.log('### records ===>'+records);
                    var requestValuefromQuery = records;
                    var url = window.location.href;
                    if (url.indexOf('&name=') > 0) {
                        var url=updateURLParameter(url,"name",requestValuefromQuery);  
                    }
                    else{
                        var UrlParameterToAdd = '&name='+requestValuefromQuery;
                        var encodedparams = encodeURIComponent(requestValuefromQuery);
                        url +='&name='+encodedparams;   
                    }
                    window.history.replaceState(null,null, url);
                    CallApexMethod(requestValuefromQuery);
                }else{
                    console.log('### ===> soql query record size is 0');
                }
                
            }
            function clearRequestValue(){
                //alert(document.getElementById("Thepage:Theform:pBS:pBSOne:RequestCombo"));
                document.getElementById("Thepage:Theform:pBS:pBSOne:RequestCombo").value="";
                document.getElementById("Thepage:Theform:pBS:warningMsg").innerHTML = "";
                var str = window.location.href;
                var nap = str.lastIndexOf("&name");
                var res = str.substring(0, nap);
                window.history.replaceState(null,null, res);
                
                
            }
            function checkLimit(limitField, limitNum)
            {
                if (limitField.value.length > limitNum) {
                    limitField.value = limitField.value.substring(0, limitNum);
                } 
            }
            </script>
