            <!--Code to add " ?id=recordid " to the base url of the visualforce page -->
            <script type="text/javascript">
            
            var previousOnload = window.onload;
            window.onload = function() 
            { 
                
                if (previousOnload) { 
                    previousOnload();
                } 
                var condition = true; // condition
                if(condition) {
                    var url = window.location.href;
                    var requestValueForNull = 'recordid';
                    if (url.indexOf('id=') > 0) {//Change from '?id=' to 'id=' for TS-9050
                        console.log('<== do nothing ==>')
                    }else{ 
                        var UrlParameterToAdd = '?id='+requestValueForNull;
                        var encodedparams = encodeURIComponent(requestValueForNull);
                        if(url.toLowerCase().indexOf('name=') > 0){//Added for TS-9050 By Exafort(Guru Dev) on 04/04/22
                            url +='&id='+encodedparams;
                        }
                        else{
                             url +='?id='+encodedparams; 
                        }
                        
                    }
                    window.history.replaceState(null,null, url);
                    //CallApexMethod();
                }
                
                
            }
            
            
            </script>
            <script type="text/javascript">
            /**Attachment TS-6516**/
            var maxStringSize = 6000000;
            function uploadFiles()
            {
                input = document.getElementById('fileinput');
                console.log('input :' + input);
                file = input.files[0];
                fr = new FileReader();
                if(file == null){ 
                    document.getElementById("{!$Component.TheformTwo.fileName}").value='';
                    document.getElementById("{!$Component.TheformTwo.fileBody}").value='';
                }
                else{
                fr.onload = receivedBinaryString;
                fr.readAsBinaryString(file);
                 }
                function receivedBinaryString(){
                    
                    var attachment = window.btoa(fr.result)
                    var fileSize = attachment.length;
                    if(fileSize != 0){
                    document.getElementById("{!$Component.TheformTwo.fileName}").value = file.name; // get inputText tag Id by from view source
                    document.getElementById("{!$Component.TheformTwo.fileBody}").value = attachment;
                    }
                    else{
                         alert("Selected file does not have any content. Please attach file with content");
                        document.getElementById('fileinput').value ="";
                        document.getElementById("{!$Component.TheformTwo.fileName}").value='';
                        document.getElementById("{!$Component.TheformTwo.fileBody}").value='';
                        }
                      
                    console.log('fileSize  : '+fileSize );
                    if(fileSize > maxStringSize )
                        alert("Base 64 Encoded file is too large.  Maximum size is " + maxStringSize + " your file is " + fileSize + ".");        
                    
                }
                
                
            }
            /**Attachment**/
            
            /*Added by exafort on 03/12/2021 for TS -8031 */
            function disableSaveButtons()
            {
                
                var requestValue = document.getElementsByClassName("btn");
                for(var i=1 ; i < requestValue.length ; i++){
                    requestValue[i].disabled = true;
                    requestValue[i].setAttribute("style", "background:#c1bebe;");
                }                                
            }
            
            function updateURLParameter(urll, param, paramVal){
                var newAdditionalURL = "";
                var tempArray = urll.split("&");
                var baseURL = tempArray[0];
                var additionalURL = tempArray[1];
                var temp = "=";
                
                if (additionalURL) {
                    if(tempArray[1].split('=')[0] == param){
                        newAdditionalURL =  tempArray[1].split('=')[0]+ temp + paramVal;;
                    }
                }
                return baseURL + "&" + newAdditionalURL;
            }
